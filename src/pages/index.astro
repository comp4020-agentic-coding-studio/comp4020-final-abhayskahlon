---
import { ACTIONS } from "../lib/creature";
import { getCreatureState } from "../lib/db";
import { getOrCreateSession } from "../lib/session";
import "../styles.css";

// Ensures every visitor has a stable cookie identity by the time they first
// look, not only once they first act (see src/lib/session.ts).
getOrCreateSession(Astro.cookies);

const state = getCreatureState();

const STAT_LABELS: Record<"hunger" | "energy" | "happiness" | "cleanliness", string> = {
  hunger: "Fullness",
  energy: "Energy",
  happiness: "Happiness",
  cleanliness: "Cleanliness",
};

const ACTION_LABELS: Record<string, string> = {
  feed: "Feed",
  play: "Play",
  walk: "Walk",
  clean: "Clean",
  sleep: "Sleep",
};

const ACTION_PAST_TENSE: Record<string, string> = {
  feed: "fed",
  play: "played with",
  walk: "walked",
  clean: "cleaned",
  sleep: "put to sleep",
};
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>COMMONS</title>
  </head>
  <body>
    <header class="site-header">
      <div>
        <a href="/">COMMONS</a>
        <nav aria-label="site">
          <a href="/readme/">About</a>
        </nav>
      </div>
    </header>
    <main>
      <h1>COMMONS</h1>
      <p>
        One shared creature, cared for by everyone here right now — not your
        own pet, everyone's.
      </p>
      <p class="live-indicator" id="live-indicator">connecting…</p>

      <div id="live-state">
        <section class="panel" aria-labelledby="creature-heading">
          <h2 id="creature-heading">The creature</h2>
          <span
            class={`activity-badge ${state.activity}`}
            id="activity-badge"
            data-activity-until={state.activityUntil ?? ""}
          >
            {state.activity === "sleeping" ? "sleeping" : "awake"}
          </span>

          {
            (Object.keys(STAT_LABELS) as (keyof typeof STAT_LABELS)[]).map((key) => (
              <div class="stat-row">
                <span>{STAT_LABELS[key]}</span>
                <span class="stat-bar">
                  <span class="stat-bar-fill" style={`width: ${state.stats[key]}%`} />
                </span>
                <span class="stat-value">{state.stats[key]}</span>
              </div>
            ))
          }

          <p class="condition">
            Overall condition: <strong>{state.health}</strong>/100 — a simple read of the four needs above, not its
            own mechanic.
          </p>

          {
            state.lastAction && (
              <p class="last-action">
                Last action: <strong>{ACTION_LABELS[state.lastAction] ?? state.lastAction}</strong>
                {state.lastActorLabel && (
                  <>
                    {" "}
                    by <strong>{state.lastActorLabel}</strong>
                  </>
                )}
              </p>
            )
          }
        </section>

        <section class="panel" aria-labelledby="history-heading">
          <h2 id="history-heading">Recent care</h2>
          <p class="panel-note">
            Everyone who's cared for this creature recently — not a leaderboard, just what happened and who was
            there.
          </p>
          {state.history.length === 0 && <p class="panel-note">Nothing yet — be the first.</p>}
          <ul class="history-list">
            {
              state.history.map((entry) => (
                <li>
                  <strong>{entry.actorLabel}</strong> {ACTION_PAST_TENSE[entry.action] ?? entry.action} the creature (
                  {entry.summary}) — {entry.createdAt}
                </li>
              ))
            }
          </ul>
        </section>
      </div>

      <section class="panel" aria-labelledby="actions-heading">
        <h2 id="actions-heading">Care for it</h2>
        <div class="actions">
          {
            ACTIONS.map((action) => (
              <form method="post" action="/api/actions" class="action-form">
                <input type="hidden" name="action" value={action} />
                <button>{ACTION_LABELS[action] ?? action}</button>
              </form>
            ))
          }
        </div>
        <p class="action-error" id="action-error" hidden></p>
      </section>
    </main>

    <script>
      // Progressive enhancement only: every form here still has a real
      // method/action, so with JavaScript disabled or failing, submitting
      // still works exactly as the server-side contract describes — a
      // rejected action's reason just arrives as a plain-text page instead
      // of inline. The server is unchanged either way: still a 303 on
      // success, still a 4xx with a reason on rejection (src/pages/api/
      // actions.ts). This only makes that reason legible without a full
      // navigation.
      const errorBox = document.getElementById("action-error");

      for (const form of document.querySelectorAll<HTMLFormElement>(".action-form")) {
        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          errorBox?.setAttribute("hidden", "");

          const res = await fetch(form.action, { method: "POST", body: new FormData(form) });
          if (res.ok) {
            location.reload(); // re-render everything from the server, same as a normal navigation would
            return;
          }

          const reason = await res.text();
          if (errorBox) {
            errorBox.textContent = reason || "that action isn't available right now";
            errorBox.removeAttribute("hidden");
          }
        });
      }

      // Purely cosmetic countdown of a timestamp the server already sent —
      // the server, not this script, decides when sleep actually ends
      // (checked lazily on the next request; see src/lib/creature.ts
      // resolveActivity). If this script never ran at all, the badge would
      // just read "sleeping" with no countdown, and the next action or
      // reload would still resolve correctly. Re-run after every live-state
      // swap below, since that replaces the badge element entirely.
      let countdownInterval: ReturnType<typeof setInterval> | undefined;
      function attachActivityCountdown() {
        clearInterval(countdownInterval);
        const badge = document.getElementById("activity-badge");
        const until = badge?.dataset.activityUntil;
        if (!badge || !until) return;
        const deadline = new Date(until).getTime();
        const tick = () => {
          const remaining = Math.max(0, Math.round((deadline - Date.now()) / 1000));
          badge.textContent = remaining > 0 ? `sleeping — ${remaining}s` : "waking up…";
          if (remaining <= 0) clearInterval(countdownInterval);
        };
        tick();
        countdownInterval = setInterval(tick, 1000);
      }
      attachActivityCountdown();

      // Real-time updates for every OTHER open session: the server pushes a
      // bare signal (no creature fields at all — see src/lib/sse.ts and
      // PROCESS.md Decision 5) whenever someone's action commits, and this
      // just re-fetches the actual server-rendered page and swaps in its
      // #live-state — the one place that already knows how to render the
      // creature. There is deliberately no second copy of "what the state
      // is" kept in this script; it never reads the event's own payload as
      // if it were the state, only as "go look again."
      async function refreshLiveState() {
        const res = await fetch("/");
        if (!res.ok) return;
        const html = await res.text();
        const next = new DOMParser().parseFromString(html, "text/html").getElementById("live-state");
        const current = document.getElementById("live-state");
        if (next && current) {
          current.replaceWith(next);
          attachActivityCountdown(); // the old badge node is gone; the new one needs its own ticker
        }
      }

      const liveIndicator = document.getElementById("live-indicator");
      function setLive(connected: boolean) {
        if (!liveIndicator) return;
        liveIndicator.textContent = connected ? "live" : "reconnecting…";
        liveIndicator.className = `live-indicator ${connected ? "connected" : "disconnected"}`;
      }

      // EventSource reconnects on its own after a drop (browser-native,
      // using the stream's `retry:` hint — see src/pages/api/events.ts) —
      // nothing extra to implement for that; this only reflects the
      // current connection state and re-subscribes to the same event name
      // each time a new connection opens.
      const events = new EventSource("/api/events");
      events.addEventListener("open", () => setLive(true));
      events.addEventListener("error", () => setLive(false));
      events.addEventListener("update", () => {
        refreshLiveState();
      });
    </script>
  </body>
</html>
