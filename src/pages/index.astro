---
import ActionIcon from "../components/ActionIcon.astro";
import { formatMiloAge } from "../components/age";
import { pickDialogue } from "../components/dialogue";
import AdventureGame from "../components/AdventureGame.astro";
import CreatureDisplay from "../components/CreatureDisplay.astro";
import Milo from "../components/Milo.astro";
import StatIcon from "../components/StatIcon.astro";
import { getLatestPatch } from "../lib/changelog";
import { ACCESSORIES, ACTIONS, APPEARANCE_LABELS, APPEARANCES, type AccessorySlot, type ActionName } from "../lib/creature";
import { defaultCreatureStats, getCreatureState, getSessionRoom } from "../lib/db";
import { suggestNextCare } from "../components/suggestions";
import { DISPLAY_NAME_MAX_LENGTH, ROOM_CODE_LENGTH } from "../lib/room";
import { getOrCreateSession } from "../lib/session";
import "../styles.css";

// Ensures every visitor has a stable cookie identity by the time they first
// look, not only once they first act (see src/lib/session.ts). This never
// implies room membership — a session can exist for a long time with
// `roomId: null`, which is exactly the "hasn't joined or hosted yet" state
// the entry experience below renders.
const session = getOrCreateSession(Astro.cookies);
const room = getSessionRoom(session);

// Only ever read on the entry branch (below) — a one-line pointer to the
// newest CHANGELOG.md entry, never shown on the room view.
const latestPatch = getLatestPatch();

// The entry page's decorative welcome illustration — rendered with the
// EXACT stats a brand-new room's Milo actually starts with
// (defaultCreatureStats(), src/lib/db.ts), not arbitrary made-up numbers:
// this is genuinely what Milo looks like the moment a first visitor hosts
// a room, not a fictional mascot. No database access here — it's a pure
// object literal.
const welcomeStats = defaultCreatureStats();

// The entry page is the default for a bare GET / even when the session
// already belongs to a room — a deliberate choice, made so a returning
// visitor always explicitly chooses to re-enter their room rather than
// landing on it silently. `?enter=1` is the one way to reach the room view
// directly: every internal link that means "go to my room" (the mutating
// routes' redirects, the client script's own post-host/join navigation,
// refreshLiveState()'s re-fetch) sets it explicitly, so the normal care
// loop and live updates are completely unaffected — only a context-free
// visit to the bare URL (a fresh page load, a bookmark, reopening the tab)
// shows the entry page. `?switch=1` still exists as an explicit alias for
// the same thing `enter` being ABSENT already does, kept only so the
// existing "Switch room" link and any bookmarked copies of it keep
// working; it is never the mechanism a fresh visit relies on, since a
// fresh visit's URL has neither parameter.
const showEntry = !room || !Astro.url.searchParams.has("enter") || Astro.url.searchParams.has("switch");

// Read once, whenever `room` exists — used by the room view below AND,
// since this entry page's "continue to your room" card wants a REAL
// milestone number (never a fabricated example), by the entry branch too.
// Safe to call unconditionally here: getCreatureState() only ever throws
// for a room id that doesn't exist, and `room` is non-null here only once
// getSessionRoom() has already confirmed it resolves to a real row.
const state = room ? getCreatureState(room.id) : null;
const age = state && room ? formatMiloAge(room.createdAt) : null;
const dialogue = state ? pickDialogue(state.stats, state.activity, state.history[0]?.createdAt ?? null) : null;

// PROCESS.md, Decision 17 — a read-only "what might help next" hint,
// derived fresh from the same stats already shown as numbers above. Never
// its own state, never broadcast, never gates an action — at most the
// single highest-priority suggestion is shown, right next to the existing
// "Last action" line it's meant to read alongside.
const suggestion = state ? (suggestNextCare(state.stats, state.activity)[0] ?? null) : null;

// The display name for whichever of the five fixed, authored appearances
// is currently selected (PROCESS.md, Decision 15) — still not a naming
// feature: a visitor picks one of five server-validated looks, the same
// shared, cosmetic mechanism wardrobe already uses, never free text. On
// the entry branch (no room yet), this stays "Milo" — the default
// appearance a brand-new room actually starts as (see welcomeStats above).
// The client script below reads this same value off a data attribute
// rather than keeping its own separate copy, so the two can never drift.
const CREATURE_NAME = state ? APPEARANCE_LABELS[state.appearance] : "Milo";

const STAT_LABELS: Record<"hunger" | "energy" | "happiness" | "cleanliness", string> = {
  hunger: "Fullness",
  energy: "Energy",
  happiness: "Happiness",
  cleanliness: "Cleanliness",
};

const ACTION_LABELS: Record<string, string> = {
  feed: "Feed",
  play: "Play",
  walk: "Walk",
  clean: "Clean",
  sleep: "Sleep",
  wardrobe: "Wardrobe",
  adventure: "Adventure",
  appearance: "Appearance",
};

const ACTION_PAST_TENSE: Record<string, string> = {
  feed: "fed",
  play: "played with",
  walk: "walked",
  clean: "cleaned",
  sleep: "put to sleep",
  wardrobe: "dressed",
  adventure: "adventured with",
  appearance: "switched the look of",
};

// Minimal "something just happened" feedback — never its own state, always
// a direct read of server fields already in `state`. While asleep,
// `state.activity` is the true current condition and wins outright; once
// that cooldown has lazily resolved back to "idle" (src/lib/creature.ts),
// this falls back to whatever the last action actually was, and to a
// neutral default if nothing has ever happened or the last thing to happen
// was itself the sleep that's now over.
const ACTIVITY_DOING: Partial<Record<string, string>> = {
  feed: `${CREATURE_NAME} is eating`,
  play: `${CREATURE_NAME} is playing`,
  walk: `${CREATURE_NAME} is out for a walk`,
  clean: `${CREATURE_NAME} is being cleaned`,
  wardrobe: `${CREATURE_NAME} is looking sharp`,
  adventure: `${CREATURE_NAME} just got back from an adventure`,
};

const activityPhrase =
  state && state.activity === "sleeping"
    ? `${CREATURE_NAME} is sleeping`
    : state
      ? (state.lastAction && ACTIVITY_DOING[state.lastAction]) || `${CREATURE_NAME} is awake`
      : "";
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>COMMONS</title>
  </head>
  <body>
    <header class="site-header">
      <div>
        <a href="/">COMMONS</a>
        <nav aria-label="site">
          <a href="/readme/">About</a>
          <a href="/patch-notes/">Patch notes</a>
        </nav>
      </div>
    </header>
    <main class="app-main">
      {
        showEntry || !room || !state || !dialogue ? (
          // .entry-page is a layout-only wrapper, scoped to this branch
          // alone (src/styles.css) — .app-main's own room-view grid rules
          // (the @media blocks further down, at 46rem/72rem) never
          // reference it, so the room view's layout is completely
          // unaffected by anything here. Two stacked sections: .entry-shell
          // (welcome column + entry column, side by side at the entry-only
          // 64rem breakpoint, stacked on mobile) and, always full-width and
          // always AFTER it (both in the DOM and visually — a sibling, not
          // a third flex child of .entry-shell, which would otherwise
          // compete for row space alongside the two real columns),
          // .entry-devnotes — matching the stacking order mobile needs:
          // identity+entry → what's new.
          <div class="entry-page">
            <div class="entry-shell">
              <div class="entry-welcome">
                <h1 id="entry-heading">Welcome to COMMONS</h1>
                <p class="intro">
                  One shared {CREATURE_NAME}, looked after by everyone in the same room — not a separate pet for each
                  of you.
                </p>

                {/* The real <Milo> component, not a lookalike decoration —
                    see welcomeStats' own comment above: these are the exact
                    stats a brand-new room's Milo actually starts with, so
                    this is genuinely what you'll meet, not a fictional
                    mascot. aria-hidden because the heading/copy around it
                    already say "Milo" in words; this is purely the visual
                    anchor. */}
                <div class="entry-illustration" aria-hidden="true">
                  <Milo activity="idle" stats={welcomeStats} />
                </div>

                <p class="entry-concept-note">
                  Feed, play, walk, clean, and send {CREATURE_NAME} on adventures together — one shared creature,
                  cared for by everyone in your room, with no score for who did the most.
                </p>

                <ul class="entry-feature-list">
                  <li>
                    <ActionIcon action="feed" /> Feed
                  </li>
                  <li>
                    <ActionIcon action="play" /> Play
                  </li>
                  <li>
                    <ActionIcon action="walk" /> Walk
                  </li>
                  <li>
                    <ActionIcon action="clean" /> Clean
                  </li>
                  <li>
                    <ActionIcon action="adventure" /> Adventure
                  </li>
                </ul>
              </div>

              <section class="panel entry-panel" aria-labelledby="entry-panel-heading">
                <h2 id="entry-panel-heading">Enter COMMONS</h2>
                <p class="entry-panel-hint">
                  Enter your name, then join a room with its code or start a brand-new one.
                </p>

                {
                  /* Shown only when this session's cookie already names a
                     room (room !== null) — e.g. a bookmark, a reopened tab,
                     or `?switch=1` from inside a room, not a first-time
                     visitor. This is the explicit "re-enter" affordance
                     Option B needs: the session and its room membership
                     were never touched by making the entry page the
                     default, so a returning visitor can always get
                     straight back in without re-joining or re-hosting
                     anything, via `?enter=1` — the same parameter every
                     internal "go to my room" link already uses. The
                     milestone line only appears here, never on the welcome
                     side for a first-time visitor, because it's real data
                     from `state` (safe to read: `room` is only non-null
                     once getSessionRoom() has confirmed it resolves to a
                     real room), never a fabricated example number. */
                  room && state && (
                    <p class="entry-returning">
                      You're still in room <strong>{room.id}</strong>
                      {state.milestone.label && <span class="milestone-badge">{state.milestone.label}</span>}
                      {" — "}
                      <strong>{state.totalCareActions}</strong> care actions so far.{" "}
                      <a href="/?enter=1">Continue to your room</a>
                    </p>
                  )
                }

                <div class="entry-choices">
                  {/* Validated server-side by src/pages/api/rooms/join.ts — this
                      form never resolves a room itself, it only ever submits what
                      a visitor typed. A room's existence is checked against the
                      database on every attempt, never assumed from this page. */}
                  <form method="post" action="/api/rooms/join" class="entry-form entry-card">
                    <h3>Join a room</h3>
                    <p class="entry-card-hint">Already have a code from someone else in the room?</p>
                    <label for="join-name">Your name</label>
                    <input
                      id="join-name"
                      name="name"
                      type="text"
                      maxlength={DISPLAY_NAME_MAX_LENGTH}
                      value={session.label}
                      required
                      autocomplete="off"
                    />
                    <label for="join-code">Room code</label>
                    <input
                      id="join-code"
                      name="roomCode"
                      type="text"
                      maxlength={ROOM_CODE_LENGTH}
                      placeholder="e.g. 4Q7K2P"
                      autocapitalize="characters"
                      autocomplete="off"
                      required
                    />
                    <button type="submit">Join room</button>
                  </form>

                  <p class="entry-or" role="separator" aria-label="or">or</p>

                  {/* A separate form, not a second button on the one above: hosting
                      takes only a name (the code is always server-generated —
                      src/lib/room.ts), so sharing a submit with "join" would mean
                      either form silently ignoring a field the other doesn't use. */}
                  <form method="post" action="/api/rooms/host" class="entry-form entry-card">
                    <h3>Host a new room</h3>
                    <p class="entry-card-hint">
                      Starting fresh? You'll get a short code to share with whoever joins you.
                    </p>
                    <label for="host-name">Your name</label>
                    <input
                      id="host-name"
                      name="name"
                      type="text"
                      maxlength={DISPLAY_NAME_MAX_LENGTH}
                      value={session.label}
                      required
                      autocomplete="off"
                    />
                    <button type="submit">Host a room</button>
                  </form>
                </div>

                <p class="entry-error" id="entry-error" role="alert" aria-live="polite" hidden />
              </section>
            </div>

            {/* Genuinely visible — a real heading and a real summary
                paragraph straight from CHANGELOG.md's own prose (src/lib/
                changelog.ts's getLatestPatch(), never invented here), not
                the small muted footer line this used to be. Still a
                teaser, not a duplicate of /patch-notes/: the full history
                lives there and only there. A SIBLING of .entry-shell, not
                a child of it — otherwise this would become a third flex
                item competing for row space alongside the two real
                columns instead of sitting full-width beneath them. */}
            {latestPatch && (
              <section class="panel entry-devnotes" aria-labelledby="entry-devnotes-heading">
                <h2 id="entry-devnotes-heading">What's new in COMMONS</h2>
                <p class="entry-devnotes-title">{latestPatch.text}</p>
                {latestPatch.summary && <p class="entry-devnotes-summary">{latestPatch.summary}</p>}
                <p class="entry-patch-note">
                  <a href={`/patch-notes/#${latestPatch.slug}`}>{latestPatch.text}</a>
                </p>
              </section>
            )}
          </div>
        ) : (
          <>
            <h1>COMMONS</h1>
            <p class="intro">
              Everyone in room <strong>{room.id}</strong> is looking after one shared creature — not your own pet.
              {/* Deliberately not the appearance-specific name here: this
                  paragraph sits outside #live-state (unchanged by
                  refreshLiveState()'s swap), so it would show a stale
                  appearance after a switch until the next full page load —
                  the same reason actions-panel's heading below stays
                  generic too. */}
              {" "}
              <a href="/?switch=1">Switch room</a>
            </p>
            <p class="live-indicator" id="live-indicator">
              connecting…
            </p>

            <div id="live-state">
              <section class="panel creature-panel" aria-labelledby="creature-heading">
                <h2 id="creature-heading">
                  {CREATURE_NAME}
                  <span class="milo-age" title={age?.milestone ?? undefined}>{age?.text}</span>
                </h2>
                {age?.milestone && <p class="milo-milestone">{age.milestone}</p>}
                {room.hostLabel && <p class="panel-note">Hosted by {room.hostLabel}</p>}

                <CreatureDisplay
                  appearance={state.appearance}
                  activity={state.activity}
                  stats={state.stats}
                  hat={state.hat}
                  neckwear={state.neckwear}
                  glasses={state.glasses}
                />

                {/* One shared creature, five looks (PROCESS.md, Decision
                    15) — a cosmetic picker, not five separate pets: every
                    visitor in the room sees the same selection, and
                    switching never touches stats/xp/history. Each form
                    carries exactly one appearance id, the same one-value-
                    per-form shape every other mutating form on this page
                    already uses. */}
                <div class="appearance-picker" role="group" aria-label="Appearance">
                  {
                    APPEARANCES.map((id) => (
                      <form method="post" action="/api/appearance" class="activity-form appearance-form">
                        <input type="hidden" name="appearance" value={id} />
                        <button
                          aria-pressed={state.appearance === id}
                          class:list={["appearance-option", { selected: state.appearance === id }]}
                        >
                          {APPEARANCE_LABELS[id]}
                        </button>
                      </form>
                    ))
                  }
                </div>

                <p class="milo-dialogue">"{dialogue}"</p>

                <span
                  class={`activity-badge ${state.activity}`}
                  id="activity-badge"
                  data-activity-until={state.activityUntil ?? ""}
                  data-creature-name={CREATURE_NAME}
                >
                  {activityPhrase}
                </span>

                {
                  (Object.keys(STAT_LABELS) as (keyof typeof STAT_LABELS)[]).map((key) => (
                    <div class="stat-row" data-stat={key}>
                      <span class="stat-label">
                        <StatIcon stat={key} class="stat-icon" />
                        {STAT_LABELS[key]}
                      </span>
                      <span class="stat-bar">
                        <span class="stat-bar-fill" style={`width: ${state.stats[key]}%`} />
                      </span>
                      <span class="stat-value">{state.stats[key]}</span>
                    </div>
                  ))
                }

                <p class="condition">
                  Overall condition: <strong>{state.health}</strong>/100 — a simple read of the four needs above, not
                  its own mechanic.
                </p>

                {/* The room's own shared, unranked lifetime total — never
                    broken down by visitor, never compared against another
                    room (PROCESS.md, Decision 14; Decision 6's "never a
                    leaderboard" rule). "Room care so far," never "You've" —
                    the same scope every other field on this panel already
                    has (hunger, hat, condition), just accumulated over
                    time instead of read at this instant. */}
                <p class="milestone-progress">
                  {state.milestone.label && <span class="milestone-badge">{state.milestone.label}</span>}
                  Room care so far: <strong>{state.totalCareActions}</strong>
                  {state.milestone.next !== null ? (
                    <> / {state.milestone.next} toward the next milestone.</>
                  ) : (
                    <> — every milestone reached!</>
                  )}
                </p>
                <span class="stat-bar milestone-bar">
                  <span class="stat-bar-fill" style={`width: ${state.milestone.progress}%`} />
                </span>

                {/* A SECOND, independent shared progress track (PROCESS.md,
                    Decision 16) — not derived from and not replacing the
                    milestone total above. `level` is always computed fresh
                    from `xp` (getProgression, src/lib/creature.ts), never
                    its own stored column, the same "derive it, don't
                    duplicate it" rule `health` already follows. Numeric XP
                    is always shown in text, never color-only, and the
                    progressbar carries real aria-value* attributes. */}
                <p class="xp-progress" data-level={state.progression.level}>
                  {state.progression.xpForLevel === null ? (
                    <>
                      Level <strong>{state.progression.level}</strong> · max level — <strong>{state.progression.xp}</strong> XP
                    </>
                  ) : (
                    <>
                      Level <strong>{state.progression.level}</strong> · <strong>{state.progression.xpIntoLevel}</strong> /{" "}
                      {state.progression.xpForLevel} XP
                    </>
                  )}
                </p>
                <span
                  class="stat-bar xp-bar"
                  role="progressbar"
                  aria-label="Level progress"
                  aria-valuenow={state.progression.progress}
                  aria-valuemin={0}
                  aria-valuemax={100}
                >
                  <span class="stat-bar-fill" style={`width: ${state.progression.progress}%`} />
                </span>

                {
                  state.lastAction && (
                    <p class="last-action">
                      Last action: <strong>{ACTION_LABELS[state.lastAction] ?? state.lastAction}</strong>
                      {state.lastActorLabel && (
                        <>
                          {" "}
                          by <strong>{state.lastActorLabel}</strong>
                        </>
                      )}
                    </p>
                  )
                }

                {/* A sibling of .last-action, deliberately never nested
                    inside it: sessions.test.ts and wardrobe.test.ts both
                    assert .last-action's exact textContent is unchanged
                    across a rejected/no-op action, so this suggestion — a
                    read of CURRENT stats, which keep moving regardless of
                    whether the last action succeeded — has to live in its
                    own element or it would make those assertions flaky. */}
                {
                  suggestion && (
                    <p class="care-suggestion">
                      <ActionIcon action={suggestion.action} class="care-suggestion-icon" />
                      A <strong>{ACTION_LABELS[suggestion.action] ?? suggestion.action}</strong> might help — {suggestion.reason}.
                    </p>
                  )
                }
              </section>

              <section class="panel history-panel" aria-labelledby="history-heading">
                <h2 id="history-heading">Recent care</h2>
                <p class="panel-note">
                  Everyone who's cared for {CREATURE_NAME} recently in this room — not a leaderboard, just what
                  happened and who was there.
                </p>
                {state.history.length === 0 && <p class="panel-note">Nothing yet — be the first.</p>}
                <ul class="history-list">
                  {
                    state.history.map((entry) => (
                      <li>
                        <ActionIcon action={entry.action as ActionName} class="history-icon" />
                        <span>
                          <strong>{entry.actorLabel}</strong> {ACTION_PAST_TENSE[entry.action] ?? entry.action}{" "}
                          {APPEARANCE_LABELS[entry.appearance] ?? CREATURE_NAME} ({entry.summary}) —{" "}
                          <span class="history-time">{entry.createdAt}</span>
                        </span>
                      </li>
                    ))
                  }
                </ul>
              </section>

              <!-- Inside #live-state deliberately, unlike actions-panel below:
                   the wardrobe forms' hidden inputs encode the OTHER slot's
                   current value (so a hat choice doesn't clobber an
                   already-chosen scarf) and the "selected" highlighting reflects
                   who most recently changed it — both need a value newer than
                   this page's first load, which only the refreshLiveState() swap
                   provides. The script's submit handler is a single delegated
                   listener on `document` (see below) specifically so it keeps
                   working for forms in here across that swap. -->
              <section class="panel activities-panel" aria-labelledby="activities-heading">
                <h2 id="activities-heading">Shared activities</h2>
                <p class="panel-note">
                  A shared look, and a shared adventure — free, cosmetic, nobody's score. Changes here are visible to
                  everyone in this room, the same as everything else {CREATURE_NAME} does.
                </p>

                {/* Each form carries exactly ONE slot + ONE value, never any
                    other slot's current value — the server reads every
                    untouched slot fresh inside its own transaction
                    (src/lib/db.ts's performWardrobeChange) precisely so a hat
                    choice can never silently revert a scarf someone else just
                    picked, no matter how stale this rendered page is.

                    Whether an item is currently EQUIPPABLE depends on the
                    room's shared level and current appearance (PROCESS.md,
                    Decision 16) — locked items stay visible with their
                    requirement rather than disappearing, and their button is
                    `disabled` so a locked item can never even be submitted;
                    the server's own check inside the transaction is the real
                    authority, this is defense in depth, not the only guard. */}
                {
                  (["hat", "glasses", "neckwear"] as AccessorySlot[]).map((slot) => {
                    const current = slot === "hat" ? state.hat : slot === "glasses" ? state.glasses : state.neckwear;
                    const options = ACCESSORIES.filter(
                      (item) => item.slot === slot && (item.compatible === "all" || item.compatible.includes(state.appearance)),
                    );
                    const slotLabel = slot === "hat" ? "Hat" : slot === "glasses" ? "Glasses" : "Neckwear";
                    return (
                      <Fragment>
                        <p class="wardrobe-slot-label">{slotLabel}</p>
                        <div class="wardrobe-options" role="group" aria-label={slotLabel}>
                          <form method="post" action="/api/wardrobe" class="activity-form wardrobe-form">
                            <input type="hidden" name="slot" value={slot} />
                            <input type="hidden" name="value" value="" />
                            <button aria-pressed={current === null} class:list={["wardrobe-option", { selected: current === null }]}>
                              None
                            </button>
                          </form>
                          {options.map((item) => {
                            const locked = item.unlockLevel > state.progression.level;
                            return (
                              <form method="post" action="/api/wardrobe" class="activity-form wardrobe-form">
                                <input type="hidden" name="slot" value={slot} />
                                <input type="hidden" name="value" value={item.id} />
                                <button
                                  aria-pressed={current === item.id}
                                  disabled={locked}
                                  class:list={["wardrobe-option", { selected: current === item.id, locked }]}
                                >
                                  {item.label}
                                  {locked && <span class="wardrobe-lock"> — Level {item.unlockLevel}</span>}
                                </button>
                              </form>
                            );
                          })}
                        </div>
                      </Fragment>
                    );
                  })
                }

                {/* PROCESS.md, Decision 18: the runner is the Adventure
                    activity's interaction layer, not a new action — this
                    component contains the exact same, only
                    .activity-form.adventure-form that lived here directly
                    before this feature, visible by default (no JS
                    required) and only ever hidden behind the game once
                    JavaScript confirms it can run. */}
                <AdventureGame appearance={state.appearance} creatureName={CREATURE_NAME} />
              </section>
            </div>

            <!-- Outside #live-state, unlike activities-panel above: these five
                 forms' hidden "action" values never depend on current creature
                 state, so there's nothing for them to go stale showing — they
                 never need to be part of the live-refreshed region. -->
            <section class="panel actions-panel" aria-labelledby="actions-heading">
              <h2 id="actions-heading">Care for your creature</h2>
              <div class="actions">
                {
                  ACTIONS.map((action) => (
                    <form method="post" action="/api/actions" class="action-form">
                      <input type="hidden" name="action" value={action} />
                      <button>
                        <ActionIcon action={action} />
                        {ACTION_LABELS[action] ?? action}
                      </button>
                    </form>
                  ))
                }
              </div>
              <p class="action-error" id="action-error" role="alert" aria-live="polite" hidden />
            </section>
          </>
        )
      }
    </main>

    <script>
      // Progressive enhancement only: every form here still has a real
      // method/action, so with JavaScript disabled or failing, submitting
      // still works exactly as the server-side contract describes — a
      // rejected action's reason just arrives as a plain-text page instead
      // of inline. The server is unchanged either way: still a 303 on
      // success, still a 4xx with a reason on rejection (src/pages/api/
      // actions.ts, src/pages/api/rooms/{host,join}.ts).
      //
      // The success path used to be `if (res.ok) location.reload()`, which
      // trusted `fetch()`'s *automatic* following of that 303 — and on
      // failure, read whatever that response's body happened to be
      // straight into the visible error box. If that followed chain ever
      // terminated in something unexpected (a non-OK response — a stray
      // 404, a CSRF rejection, anything), its full response body, HTML
      // document included, would get dumped as the "reason" text, and
      // because `res.ok` was false, `location.reload()` never fired
      // either: the actor's own tab would show a garbled error while the
      // server had already committed the action. `res.redirected` is the
      // one thing fetch exposes unambiguously here: a 303 is the ONLY way
      // any of this server's success responses are ever followed anywhere,
      // so "was redirected" IS "the action is successful" — checked
      // directly, not inferred from whatever the followed response's
      // status became.
      const errorBox = document.getElementById("action-error");
      const entryErrorBox = document.getElementById("entry-error");

      // The server is the only source of truth for why an action was
      // rejected — this never guesses, constructs, or duplicates a reason
      // client-side; it only ever reads exactly what the server sent
      // (e.g. "too hungry to sleep", "no room with that code"). The one
      // thing it refuses to trust blindly is the response's own
      // CONTENT-TYPE: if that's ever HTML (a proxy error page, a misrouted
      // 404, anything that isn't this app's own plain-text response),
      // that's a sign something is wrong upstream, not content to show a
      // visitor — never rendered, not even as plain text. Returns null,
      // never an empty string, whenever there's no safe reason to show, so
      // the generic fallback is the caller's decision, not this one's.
      async function readRejectionReason(res: Response): Promise<string | null> {
        const contentType = (res.headers.get("content-type") ?? "").toLowerCase();
        if (contentType.includes("html")) return null;
        const text = await res.text();
        return text.length > 0 ? text : null;
      }

      // The five care-action forms, the shared-activity forms (wardrobe,
      // adventure), AND the two room entry forms (join, host) all go
      // through this exact same handler — it was already fully generic
      // (reads form.getAttribute("action"), checks res.redirected), so the
      // new forms need their own class rather than reusing ".action-form":
      // spec/action-form-url.test.ts asserts every ".action-form" resolves
      // to exactly "/api/actions", which a wardrobe/adventure/entry form
      // pointing elsewhere would break. ".activity-form" and ".entry-form"
      // get everything this handler does, including the same
      // form.getAttribute("action") fix (never form.action) that test
      // exists to protect, just without that one test asserting it for
      // these specific forms too.
      //
      // One delegated listener on `document`, attached exactly once, rather
      // than a per-form loop: the wardrobe forms' hidden inputs encode the
      // OTHER slot's current value (so picking a hat doesn't clobber an
      // already-chosen scarf), which means they have to live inside
      // #live-state to ever see a value newer than the page's first load —
      // and anything inside #live-state gets replaced wholesale by
      // refreshLiveState(). A per-element loop's listeners would NOT follow
      // their elements through that replacement (confirmed while verifying
      // this: picking a hat, then a scarf, silently reverted the hat to
      // whatever it was on first page load). Delegation sidesteps this
      // entirely — the listener lives on `document`, which is never
      // replaced, and `submit` bubbles there from whichever form element is
      // live in the DOM at the moment of the click, old or newly-swapped.
      document.addEventListener("submit", async (event) => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement) || !form.matches(".action-form, .activity-form, .entry-form")) return;

        event.preventDefault();
        errorBox?.setAttribute("hidden", "");
        entryErrorBox?.setAttribute("hidden", "");

        const isEntryForm = form.matches(".entry-form");
        const formData = new FormData(form);
        const actionName = String(formData.get("action") ?? "");

        // Purely a UI affordance for the duration of this one request —
        // doesn't touch the request itself, and nothing in spec/ drives
        // the client script's button behaviour (those files POST straight
        // to the API routes from Node, never through this loaded page), so
        // there's no existing contract this could disturb.
        const button = form.querySelector("button");
        button?.setAttribute("data-loading", "");
        if (button) button.disabled = true;

        try {
          // Not form.action: this form has a control named "action" (the
          // hidden input carrying which action this is) on the care/
          // activity forms, and a named form control shadows the form
          // element's own built-in `action` property in real browsers —
          // form.action resolves to that HTMLInputElement, not the URL
          // string, and fetch() silently stringifies it to
          // "[object HTMLInputElement]". getAttribute() reads the literal
          // attribute value, bypassing that shadowing entirely, and is what
          // a real Chrome diagnostic (status 404, url ending in
          // "/[object%20HTMLInputElement]") confirmed was actually
          // happening — never reproduced by any scripted request, since
          // those never touched the DOM's `form.action` property at all.
          // Never rename the "action" input to dodge this: the server's
          // whole validated vocabulary (src/lib/creature.ts ACTIONS,
          // src/pages/api/actions.ts's form.get("action")) is built around
          // that field name, and it's correct — the bug was purely in how
          // the URL got read on this side. The entry forms have no such
          // control (their fields are "name"/"roomCode"), so this is
          // belt-and-braces there too, not just load-bearing for the forms
          // that actually have an "action" field.
          const actionUrl = form.getAttribute("action") ?? "/api/actions";
          const res = await fetch(actionUrl, { method: "POST", body: formData });

          if (res.redirected) {
            if (isEntryForm) {
              // A genuine page-shape change, not the same situation
              // Incident 1 was about: #live-state doesn't exist yet on the
              // entry page, there is nothing for refreshLiveState() to
              // swap into. A hard navigation is the correct, simplest way
              // to move from "no room" to "this room's Milo" — unlike the
              // care/activity forms, which stay on the same page shape
              // before and after, so they keep using refreshLiveState().
              // "/?enter=1", not "/": hosting/joining just succeeded
              // (res.redirected is true), so this should land directly on
              // the room view, not bounce back to the entry page the way a
              // bare "/" now would (see showEntry's comment).
              location.href = "/?enter=1";
              return;
            }
            // Success: re-fetch and swap the COMPLETE live state — stats,
            // condition, activity, last action, and history together —
            // the same path an SSE "update" event triggers for everyone
            // else, so the actor's own tab and every other open tab go
            // through the exact same, single, tested refresh.
            await refreshLiveState();
            // Only reachable because THIS tab's own fetch just observed
            // res.redirected === true for ITS OWN request — the one
            // signal that's always been reliable here (Incident 1), and
            // already local to this closure. Applied AFTER the swap
            // above, to the freshly-inserted Milo node: refreshLiveState()
            // replaces #live-state wholesale, so setting this any earlier
            // would just be discarded with the old node. No other tab's
            // script ever runs this line for someone else's action — the
            // only other way anything here calls refreshLiveState() is
            // the SSE "update" listener below, which never calls
            // playReaction. See Milo.astro for what each action reveals.
            playReaction(actionName);
            return;
          }

          const reason = await readRejectionReason(res);
          if (isEntryForm) {
            if (entryErrorBox) {
              entryErrorBox.textContent = reason ?? "that didn't work — try again";
              entryErrorBox.removeAttribute("hidden");
            }
            return;
          }
          if (errorBox) {
            errorBox.textContent = reason ?? "that action isn't available right now";
            errorBox.removeAttribute("hidden");
          }

          // A rejection means this tab's own view of Milo might be exactly
          // what caused it — e.g. this tab still showed "awake" because it
          // missed the event for a sleep someone else (or this same tab,
          // earlier) triggered, and the server, correctly, just said
          // otherwise. Refreshing here is what makes that visible instead
          // of leaving a stale badge sitting right next to a reason that
          // contradicts it: the one authoritative picture is always
          // whatever the server just said, never whatever this tab
          // happened to be showing before it asked. Deliberately no
          // playReaction() call on this path — a rejection never earns a
          // successful-action reaction.
          await refreshLiveState();
        } finally {
          button?.removeAttribute("data-loading");
          if (button) button.disabled = false;
        }
      });

      // Brief, additive post-success reaction — see the call site above for
      // why this can only ever run in the tab whose own action just
      // genuinely succeeded. Milo.astro always renders all five reaction
      // groups, hidden by CSS; this only ever toggles which one is visible,
      // never anything about the real, server-rendered expression beneath
      // it, and never anything that could be mistaken for a second copy of
      // creature state.
      let reactionTimer: ReturnType<typeof setTimeout> | undefined;
      function playReaction(action: string) {
        const milo = document.querySelector<HTMLElement>(".milo-visual");
        if (!milo) return;
        clearTimeout(reactionTimer);
        milo.setAttribute("data-reaction", action);
        reactionTimer = setTimeout(() => milo.removeAttribute("data-reaction"), 1600);
      }

      // Purely cosmetic countdown of a timestamp the server already sent —
      // the server, not this script, decides when sleep actually ends
      // (checked lazily on the next request; see src/lib/creature.ts
      // resolveActivity). If this script never ran at all, the badge would
      // just read "Milo is sleeping" with no countdown, and the next action
      // or refresh would still resolve correctly. Re-run after every
      // live-state swap below, since that replaces the badge element
      // entirely — the server-rendered text it starts with (computed from
      // state.activity / state.lastAction, never invented here) is what
      // this only ever adds a live countdown on top of. A no-op on the
      // entry page, where #activity-badge doesn't exist.
      let countdownInterval: ReturnType<typeof setInterval> | undefined;
      function attachActivityCountdown() {
        clearInterval(countdownInterval);
        const badge = document.getElementById("activity-badge");
        const until = badge?.dataset.activityUntil;
        // Read the creature's current display name off the badge's own
        // data attribute — set server-side from `state.appearance`
        // (src/lib/creature.ts's APPEARANCE_LABELS) — rather than a second,
        // hardcoded copy here that could drift from whichever of the five
        // appearances is actually selected.
        const name = badge?.dataset.creatureName ?? "Milo";
        if (!badge || !until) return;
        const deadline = new Date(until).getTime();
        const tick = () => {
          const remaining = Math.max(0, Math.round((deadline - Date.now()) / 1000));
          badge.textContent = remaining > 0 ? `${name} is sleeping — ${remaining}s` : `${name} is waking up…`;
          if (remaining <= 0) clearInterval(countdownInterval);
        };
        tick();
        countdownInterval = setInterval(tick, 1000);
      }
      attachActivityCountdown();

      // Real-time updates for every open session IN THIS ROOM, including
      // the actor's own tab: the server pushes a bare signal (no creature
      // fields at all — see src/lib/sse.ts and PROCESS.md Decision 5)
      // whenever someone in this same room's action commits, and this just
      // re-fetches the actual server-rendered page and swaps in its ENTIRE
      // #live-state — stats, condition, activity, last action AND the
      // Recent care history together, in one replacement, since all of it
      // lives inside that one container and this never swaps in less than
      // the whole thing. There is deliberately no second copy of "what the
      // state is" kept in this script; it never reads the event's own
      // payload as if it were the state, only as "go look again." A no-op
      // on the entry page, where there is no room to subscribe to yet
      // (src/pages/api/events.ts returns 403 for a session with no room,
      // so this just never connects — nothing to reconnect either).
      //
      // `refreshSeq` guards against a real risk once more than one person
      // is acting at once (which is the entire premise of this app): two
      // overlapping refreshes can resolve out of order, and without this,
      // a slower, now-stale response arriving after a faster, fresher one
      // would silently overwrite it — stats or history could appear to
      // "go backwards" to an earlier version. Each call claims the latest
      // sequence number and checked again after every await; a call that's
      // no longer the latest discards its own result instead of applying it.
      let refreshSeq = 0;
      async function refreshLiveState() {
        const seq = ++refreshSeq;
        // "/?enter=1", not "/": this only ever runs from a page that
        // already rendered #live-state (after this tab's own action, or an
        // SSE "update" from another tab in the same room — see the comment
        // at this function's only two call sites), so the fetch has to ask
        // for the room view explicitly now that a bare "/" shows the entry
        // page by default (see showEntry's comment in the frontmatter
        // above). Without this, the parsed response would have no
        // #live-state node at all, and the `if (!next ...) return` guard
        // below would silently stop every live update from ever applying.
        const res = await fetch("/?enter=1", { cache: "no-store" });
        if (seq !== refreshSeq) return; // superseded by a newer refresh while this one was in flight
        if (!res.ok) return; // never parse or inject a non-OK response's body
        const html = await res.text();
        if (seq !== refreshSeq) return; // re-check: the second await is another chance to go stale
        const next = new DOMParser().parseFromString(html, "text/html").getElementById("live-state");
        const current = document.getElementById("live-state");
        if (!next || !current) return;
        current.replaceWith(next);
        attachActivityCountdown(); // the old badge node is gone; the new one needs its own ticker
      }

      const liveIndicator = document.getElementById("live-indicator");
      function setLive(connected: boolean) {
        if (!liveIndicator) return;
        liveIndicator.textContent = connected ? "live" : "reconnecting…";
        liveIndicator.className = `live-indicator ${connected ? "connected" : "disconnected"}`;
      }

      // EventSource reconnects on its own after a drop (browser-native,
      // using the stream's `retry:` hint — see src/pages/api/events.ts) —
      // nothing extra to implement for that; this only reflects the
      // current connection state and re-subscribes to the same event name
      // each time a new connection opens. Only created on a page that
      // actually rendered a room (#live-indicator only exists then) — the
      // entry page never opens this connection at all.
      if (liveIndicator) {
        const events = new EventSource("/api/events");
        events.addEventListener("open", () => setLive(true));
        events.addEventListener("error", () => setLive(false));
        events.addEventListener("update", () => {
          refreshLiveState();
        });
      }
    </script>
  </body>
</html>
