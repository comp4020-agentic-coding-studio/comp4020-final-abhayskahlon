---
// Oliver's visual identity — a fluffy white rabbit, one of the five fixed,
// authored appearances the room's one shared creature can switch between
// (PROCESS.md, Decision 15). A self-contained sibling of Milo.astro: same
// Props shape, same mood-driven face branching via the already
// species-agnostic computeMood() (src/components/mood.ts), same
// always-rendered-but-hidden reaction-mark pattern, same scoped-style
// approach — deliberately NOT refactored into a shared base component with
// Milo.astro (see PROCESS.md, Decision 15, "no premature abstraction").
//
// Distinguishing silhouette: two tall, long ears, a small triangular nose,
// a round cotton-tail. The `bunny-ears` wardrobe item is deliberately
// excluded from Oliver's compatible list in src/lib/creature.ts's
// ACCESSORIES (he's already a rabbit), and this component intentionally
// renders nothing for that id even if it were somehow equipped, as a
// second, defense-in-depth layer below the server's own validation.
import type { Activity, Stats } from "../lib/creature";
import { computeMood } from "./mood";

interface Props {
  activity: Activity;
  stats: Stats;
  hat?: string | null;
  neckwear?: string | null;
  glasses?: string | null;
}

const { activity, stats, hat = null, neckwear = null, glasses = null } = Astro.props;
const sleeping = activity === "sleeping";
const { family, severe } = computeMood(stats, activity);

function sparkle(cx: number, cy: number, r: number): string {
  const inner = r * 0.22;
  return `M${cx} ${cy - r} L${cx + inner} ${cy - inner} L${cx + r} ${cy} L${cx + inner} ${cy + inner} L${cx} ${cy + r} L${cx - inner} ${cy + inner} L${cx - r} ${cy} L${cx - inner} ${cy - inner} Z`;
}
---

<div class={`oliver-visual oliver-${family}`} data-severe={severe ? "true" : "false"}>
  <svg viewBox="0 0 160 160" class="oliver-svg" role="img" aria-label={`Oliver, ${sleeping ? "asleep" : family}`}>
    <!-- cotton tail, peeking from behind -->
    <circle class="oliver-tail" cx="124" cy="122" r="11" />

    <!-- feet -->
    <ellipse class="oliver-foot" cx="58" cy="144" rx="11" ry="6" />
    <ellipse class="oliver-foot" cx="102" cy="144" rx="11" ry="6" />

    <!-- long ears, drawn before the body so the body overlaps their base.
         Kept close to the viewBox's own top edge (unlike a taller version
         that clipped into page content above the SVG when rendered inside
         a container with no extra headroom) — still clearly "long ears,"
         just not so tall they escape the creature's own visual frame. -->
    <ellipse class="oliver-body-fill" cx="62" cy="10" rx="10.5" ry="24" transform="rotate(-6 62 10)" />
    <ellipse class="oliver-body-fill" cx="98" cy="10" rx="10.5" ry="24" transform="rotate(6 98 10)" />
    <ellipse class="oliver-ear-inner" cx="62" cy="12" rx="5" ry="18" transform="rotate(-6 62 12)" />
    <ellipse class="oliver-ear-inner" cx="98" cy="12" rx="5" ry="18" transform="rotate(6 98 12)" />

    <!-- body -->
    <path
      class="oliver-body-fill"
      d="M80 18c31 0 52 24 54 57 2 27-10 55-37 63-11 3-23 3-34 0-27-8-39-36-37-63 2-33 23-57 54-57z"
    />

    <!-- belly marking -->
    <ellipse class="oliver-belly" cx="80" cy="102" rx="26" ry="29" />

    <!-- cheeks -->
    <ellipse class="oliver-cheek" cx="54" cy="90" rx="8" ry="5" />
    <ellipse class="oliver-cheek" cx="106" cy="90" rx="8" ry="5" />

    <!-- small triangular nose -->
    <path class="oliver-nose" d="M80 92l-4 5h8z" />

    {
      hat === "top-hat" && (
        <g class="oliver-wardrobe oliver-hat-top" aria-hidden="true">
          <path d="M64 23c0-11 7-19 16-19s16 8 16 19z" />
          <ellipse cx="80" cy="23" rx="20" ry="4" />
          <rect x="65" y="14" width="30" height="5" />
        </g>
      )
    }
    {
      hat === "party-hat" && (
        <g class="oliver-wardrobe oliver-hat-party" aria-hidden="true">
          <path d="M80 3 L65 26 L95 26 Z" />
          <path d="M80 3 L75 14 L85 14 Z" class="oliver-hat-party-stripe" />
          <circle cx="80" cy="3" r="3" class="oliver-hat-party-pom" />
        </g>
      )
    }
    {
      hat === "beanie" && (
        <g class="oliver-wardrobe oliver-beanie" aria-hidden="true">
          <path d="M62 24c0-12 8-21 18-21s18 9 18 21z" />
          <rect x="60" y="20" width="40" height="7" rx="3" />
          <circle cx="80" cy="3" r="4" class="oliver-beanie-pom" />
        </g>
      )
    }
    {/* Deliberately no `hat === "bunny-ears"` branch — Oliver's own ears
        already fill that role, and src/lib/creature.ts's ACCESSORIES
        registry excludes "oliver" from bunny-ears' compatible list, so the
        server already rejects equipping it here before this ever matters.
        This is the second, defense-in-depth layer: even a value that
        somehow reached this component unexpectedly renders nothing. */}
    {
      hat === "wizard-hat" && (
        <g class="oliver-wardrobe oliver-wizard-hat" aria-hidden="true">
          <path d="M80 -2 L62 26 L98 26 Z" />
          <ellipse cx="80" cy="26" rx="22" ry="4" />
          <circle cx="76" cy="14" r="1.6" class="oliver-wizard-star" />
          <circle cx="86" cy="8" r="1.3" class="oliver-wizard-star" />
        </g>
      )
    }
    {
      hat === "golden-crown" && (
        <g class="oliver-wardrobe oliver-golden-crown" aria-hidden="true">
          <path d="M60 24 L66 8 L74 18 L80 4 L86 18 L94 8 L100 24 Z" />
          <rect x="60" y="22" width="40" height="6" rx="2" />
          <circle cx="80" cy="4" r="2.4" class="oliver-crown-gem" />
        </g>
      )
    }
    {
      neckwear === "bow-tie" && (
        <g class="oliver-wardrobe oliver-bow-tie" aria-hidden="true">
          <path d="M80 108 L68 102 L68 114 Z" />
          <path d="M80 108 L92 102 L92 114 Z" />
          <circle cx="80" cy="108" r="3.2" class="oliver-bow-knot" />
        </g>
      )
    }
    {
      neckwear === "scarf" && (
        <g class="oliver-wardrobe oliver-scarf" aria-hidden="true">
          <path d="M57 106c6 8 40 8 46 0l-2 9c-11 5-31 5-42 0z" />
          <path d="M90 112l8 16-10 1-5-15z" class="oliver-scarf-tail" />
        </g>
      )
    }
    {
      neckwear === "knit-scarf" && (
        <g class="oliver-wardrobe oliver-knit-scarf" aria-hidden="true">
          <path d="M55 107c7 9 43 9 50 0l-2 10c-13 6-33 6-46 0z" />
          <path d="M88 116l6 18-9 1-5-17z" class="oliver-knit-scarf-tail" />
        </g>
      )
    }

    {
      sleeping ? (
        <g class="oliver-face oliver-face-sleeping">
          <path class="oliver-eye-line" d="M48 74c5-5 13-5 18 0" />
          <path class="oliver-eye-line" d="M94 74c5-5 13-5 18 0" />
          <path class="oliver-mouth" d="M72 96c5 4 11 4 16 0" />
          <g class="oliver-zzz" aria-hidden="true">
            <text x="112" y="46" class="oliver-zzz-char oliver-zzz-1">z</text>
            <text x="124" y="34" class="oliver-zzz-char oliver-zzz-2">z</text>
            <text x="136" y="23" class="oliver-zzz-char oliver-zzz-3">z</text>
          </g>
        </g>
      ) : family === "happy" ? (
        <g class="oliver-face">
          <ellipse class="oliver-eye" cx="56" cy="76" rx="10" ry="11" />
          <ellipse class="oliver-eye" cx="103" cy="76" rx="8.5" ry="9.5" />
          <circle class="oliver-eye-highlight" cx="59.5" cy="71.5" r="2.6" />
          <circle class="oliver-eye-highlight" cx="105.5" cy="72" r="2.2" />
          <path class="oliver-mouth" d="M64 97c7 8 25 8 32 0" />
        </g>
      ) : family === "excited" ? (
        <g class="oliver-face">
          <ellipse class="oliver-eye" cx="56" cy="76" rx="10.5" ry="11.5" />
          <ellipse class="oliver-eye" cx="103" cy="76" rx="9" ry="10" />
          <circle class="oliver-eye-highlight" cx="59.5" cy="71" r="3" />
          <circle class="oliver-eye-highlight" cx="106" cy="71.5" r="2.6" />
          <path class="oliver-mouth" d="M60 96c8 11 32 11 40 0" />
          <g class="oliver-sparkle-ambient" aria-hidden="true">
            <path d={sparkle(18, 44, 6.5)} />
            <path d={sparkle(136, 38, 6)} />
          </g>
        </g>
      ) : family === "sleepy" ? (
        <g class="oliver-face">
          <path class="oliver-eye-lid" d="M47 72c4-3 14-3 18 0l-1 6c-4 2-12 2-16 0z" />
          <path class="oliver-eye-lid" d="M95 72c4-3 13-3 17 0l-1 6c-4 2-11 2-15 0z" />
          <path class="oliver-eye-bag" d="M48 81c3 2 11 2 15 0" />
          <path class="oliver-eye-bag" d="M96 81c3 2 10 2 14 0" />
          {severe ? (
            <>
              <ellipse class="oliver-mouth-open" cx="80" cy="99" rx="6.5" ry="5.5" />
              <text x="100" y="66" class="oliver-zzz-char oliver-zzz-solo">z</text>
            </>
          ) : (
            <path class="oliver-mouth" d="M68 98c4 2 20 2 24 0" />
          )}
        </g>
      ) : family === "hungry" ? (
        <g class="oliver-face">
          <path class="oliver-brow-up" d="M48 65c3-3 9-3 12-1" />
          <path class="oliver-brow-up" d="M100 64c3-3 9-3 12 1" />
          <ellipse class="oliver-eye" cx="56" cy="78" rx="10.5" ry="11" />
          <ellipse class="oliver-eye" cx="103" cy="78" rx="9" ry="9.5" />
          <circle class="oliver-eye-highlight" cx="59" cy="74" r="2.8" />
          <circle class="oliver-eye-highlight" cx="105.5" cy="74.5" r="2.3" />
          <path class="oliver-mouth" d="M68 99c3-3 9 3 12 0c3-3 9 3 12 0" />
          {severe && <path class="oliver-rumble" d="M66 103c4-6 8 6 12 0s8-6 12 0" />}
        </g>
      ) : family === "sad" ? (
        <g class="oliver-face">
          <path class="oliver-brow-down" d="M48 67c3 3 9 4 12 2" />
          <path class="oliver-brow-down" d="M100 69c3-2 9-3 12-1" />
          <ellipse class="oliver-eye" cx="56" cy="78" rx="9" ry="9.5" />
          <ellipse class="oliver-eye" cx="103" cy="78" rx="8" ry="8.5" />
          <path class="oliver-mouth" d="M64 101c7-8 25-8 32 0" />
          {severe && (
            <g class="oliver-cloud" aria-hidden="true">
              <path d="M58 18c-5 0-8 3-9 6-4 1-7 4-7 8 0 4 4 7 8 7h23c4 0 7-3 7-7 0-3-2-6-5-7 0-5-4-9-9-9-3 0-6 1-8 2z" />
              <path class="oliver-raindrop oliver-raindrop-1" d="M58 42v5" />
              <path class="oliver-raindrop oliver-raindrop-2" d="M70 44v5" />
            </g>
          )}
        </g>
      ) : (
        <g class="oliver-face">
          <path class="oliver-eye-line oliver-eye-squint" d="M47 75c4-4 13-4 18 0" />
          <ellipse class="oliver-eye" cx="103" cy="77" rx="7.5" ry="8" />
          <circle class="oliver-eye-highlight" cx="105" cy="74" r="1.8" />
          <path class="oliver-mouth" d="M70 98c4 3 12 3 16 0" />
          <g class="oliver-dirt" aria-hidden="true">
            <ellipse cx="64" cy="116" rx="2.6" ry="1.8" transform="rotate(20 64 116)" />
            <ellipse cx="94" cy="120" rx="2.2" ry="1.6" transform="rotate(-15 94 120)" />
            <ellipse cx="74" cy="127" rx="2" ry="1.5" />
            <ellipse cx="100" cy="109" rx="1.8" ry="1.4" />
          </g>
          {severe && (
            <>
              <path class="oliver-stink oliver-stink-1" d="M26 68c-2-4 2-6 0-10s2-6 0-10" />
              <path class="oliver-stink oliver-stink-2" d="M136 64c2-4-2-6 0-10s-2-6 0-10" />
            </>
          )}
        </g>
      )
    }

    {
      glasses === "round-glasses" && (
        <g class="oliver-wardrobe oliver-round-glasses" aria-hidden="true">
          <circle cx="56" cy="78" r="9" />
          <circle cx="104" cy="78" r="9" />
          <path d="M65 78h30" />
        </g>
      )
    }
    {
      glasses === "heart-glasses" && (
        <g class="oliver-wardrobe oliver-heart-glasses" aria-hidden="true">
          <path d="M56 73c-3-3-8-2-8 2 0 3 4 6 8 9 4-3 8-6 8-9 0-4-5-5-8-2z" />
          <path d="M104 73c-3-3-8-2-8 2 0 3 4 6 8 9 4-3 8-6 8-9 0-4-5-5-8-2z" />
          <path d="M64 78h32" />
        </g>
      )
    }

    <g class="oliver-reaction oliver-reaction-feed" aria-hidden="true">
      <circle cx="66" cy="108" r="3.2" />
      <circle cx="94" cy="110" r="2.6" />
      <circle cx="80" cy="116" r="2.3" />
    </g>
    <g class="oliver-reaction oliver-reaction-play" aria-hidden="true">
      <path d={sparkle(36, 58, 7)} />
      <path d={sparkle(124, 54, 6)} />
      <path d={sparkle(80, 28, 5)} />
    </g>
    <g class="oliver-reaction oliver-reaction-walk" aria-hidden="true">
      <path d="M24 136c-4 1-6 4-6 7" />
      <path d="M19 125c-4 1-7 3-8 6" />
      <path d="M27 147c-4 0-7 2-8 5" />
    </g>
    <g class="oliver-reaction oliver-reaction-clean" aria-hidden="true">
      <circle class="oliver-bubble" cx="38" cy="68" r="4" />
      <circle class="oliver-bubble" cx="125" cy="58" r="3" />
      <circle class="oliver-bubble" cx="119" cy="94" r="2.4" />
      <path d={sparkle(80, 54, 5)} />
    </g>
    <g class="oliver-reaction oliver-reaction-adventure" aria-hidden="true">
      <ellipse class="oliver-mud" cx="58" cy="118" rx="6" ry="3.5" transform="rotate(-10 58 118)" />
      <ellipse class="oliver-mud" cx="100" cy="124" rx="5" ry="3" transform="rotate(8 100 124)" />
      <ellipse class="oliver-mud" cx="78" cy="132" rx="4" ry="2.4" />
    </g>
  </svg>
</div>

<style>
  .oliver-visual {
    position: relative;
    display: inline-block;
    width: clamp(7.5rem, 24vw, 10.5rem);
    margin: 0 auto;
  }

  .oliver-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .oliver-body-fill {
    fill: var(--oliver-body, #fdfdfb);
    stroke: var(--oliver-outline, #9a8f82);
    stroke-width: 3;
    stroke-linejoin: round;
  }

  .oliver-ear-inner {
    fill: #ffc3c9;
    stroke: none;
  }

  .oliver-foot {
    fill: var(--oliver-body, #fdfdfb);
    stroke: var(--oliver-outline, #9a8f82);
    stroke-width: 3;
  }

  .oliver-tail {
    fill: var(--oliver-body, #fdfdfb);
    stroke: var(--oliver-outline, #9a8f82);
    stroke-width: 3;
  }

  .oliver-belly {
    fill: var(--oliver-belly, #ffffff);
    stroke: none;
  }

  .oliver-cheek {
    fill: #ff8fa3;
    opacity: 0.4;
    transform-origin: center;
  }

  .oliver-nose {
    fill: #e89aa0;
  }

  .oliver-eye,
  .oliver-eye-lid {
    fill: var(--oliver-outline, #5c5248);
  }

  .oliver-eye-line,
  .oliver-eye-squint {
    fill: none;
    stroke: var(--oliver-outline, #5c5248);
    stroke-width: 3;
    stroke-linecap: round;
  }

  .oliver-eye-bag,
  .oliver-brow-up,
  .oliver-brow-down,
  .oliver-rumble,
  .oliver-stink {
    fill: none;
    stroke: var(--oliver-outline, #5c5248);
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0.55;
  }

  .oliver-eye-highlight {
    fill: #fff;
  }

  .oliver-mouth {
    fill: none;
    stroke: var(--oliver-outline, #5c5248);
    stroke-width: 3;
    stroke-linecap: round;
  }

  .oliver-mouth-open {
    fill: var(--oliver-outline, #5c5248);
    opacity: 0.85;
  }

  .oliver-wardrobe {
    stroke: var(--oliver-outline, #5c5248);
    stroke-width: 1.6;
    stroke-linejoin: round;
  }

  .oliver-hat-top {
    fill: #2b2420;
  }
  .oliver-hat-party {
    fill: #ff8a5b;
  }
  .oliver-hat-party-stripe {
    fill: #fff6d8;
  }
  .oliver-hat-party-pom {
    fill: #ffcf6b;
  }
  .oliver-beanie {
    fill: #5b8aa8;
  }
  .oliver-beanie-pom {
    fill: #fff;
  }
  .oliver-wizard-hat {
    fill: #5a3fae;
  }
  .oliver-wizard-star {
    fill: #ffd76b;
    stroke: none;
  }
  .oliver-golden-crown {
    fill: #f4c430;
  }
  .oliver-crown-gem {
    fill: #c7453a;
    stroke: none;
  }
  .oliver-round-glasses,
  .oliver-heart-glasses {
    fill: none;
    stroke: #2b2420;
    stroke-width: 2.2;
  }
  .oliver-bow-tie {
    fill: #c7453a;
  }
  .oliver-bow-knot {
    fill: #9c342b;
    stroke: none;
  }
  .oliver-scarf,
  .oliver-scarf-tail {
    fill: #3f8f5f;
  }
  .oliver-knit-scarf,
  .oliver-knit-scarf-tail {
    fill: #6a4fae;
  }

  .oliver-happy,
  .oliver-excited {
    --oliver-body: #fdfdfb;
    --oliver-belly: #ffffff;
  }

  .oliver-sleepy,
  .oliver-sleeping {
    --oliver-body: #e3e2de;
    --oliver-belly: #f1f0ec;
  }

  .oliver-hungry {
    --oliver-body: #f7f3ea;
    --oliver-belly: #fffdf6;
  }

  .oliver-sad {
    --oliver-body: #dde3ea;
    --oliver-belly: #eef1f6;
  }

  .oliver-messy {
    --oliver-body: #d8cdb8;
    --oliver-belly: #ece3cf;
  }

  .oliver-sparkle-ambient path {
    fill: #ffcf6b;
  }

  .oliver-cloud path:first-child {
    fill: #c6d3e2;
  }

  .oliver-raindrop {
    stroke: #8fa9c9;
    stroke-width: 2.4;
    stroke-linecap: round;
    animation: oliver-raindrop-fall 1.6s ease-in infinite;
  }

  .oliver-raindrop-2 {
    animation-delay: 0.5s;
  }

  .oliver-dirt ellipse {
    fill: #8a6a49;
    opacity: 0.6;
  }

  .oliver-zzz-char {
    font: 700 1rem/1 ui-rounded, system-ui, sans-serif;
    fill: var(--color-muted);
  }

  .oliver-zzz-solo {
    font-size: 0.75rem;
    opacity: 0.7;
    animation: oliver-zzz-float 2.6s ease-in infinite;
  }

  .oliver-reaction {
    opacity: 0;
  }

  .oliver-reaction-feed circle {
    fill: #c98a4b;
  }

  .oliver-reaction-play path {
    fill: #ffcf6b;
  }

  .oliver-reaction-walk path {
    fill: none;
    stroke: var(--color-accent-ink, #b84b22);
    stroke-width: 2.2;
    stroke-linecap: round;
    opacity: 0.6;
  }

  .oliver-reaction-clean .oliver-bubble {
    fill: #dff3fb;
    stroke: #bfe3f2;
    stroke-width: 1;
  }

  .oliver-reaction-clean path:not(.oliver-bubble) {
    fill: #fff6d8;
  }

  .oliver-reaction-adventure .oliver-mud {
    fill: #8a6a49;
    opacity: 0.75;
  }

  .oliver-visual[data-reaction="feed"] .oliver-reaction-feed,
  .oliver-visual[data-reaction="play"] .oliver-reaction-play,
  .oliver-visual[data-reaction="walk"] .oliver-reaction-walk,
  .oliver-visual[data-reaction="clean"] .oliver-reaction-clean,
  .oliver-visual[data-reaction="adventure"] .oliver-reaction-adventure {
    animation: oliver-reaction-mark 1.4s ease-out;
  }

  .oliver-visual[data-reaction="feed"] .oliver-cheek {
    animation: oliver-cheek-puff 1.4s ease-out;
  }

  @keyframes oliver-reaction-mark {
    0% {
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    75% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes oliver-cheek-puff {
    0%,
    100% {
      transform: scale(1);
    }
    30% {
      transform: scale(1.22);
    }
  }

  @keyframes oliver-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    25% {
      transform: translateY(-6px);
    }
    50% {
      transform: translateY(0);
    }
    70% {
      transform: translateY(-3px);
    }
  }

  @keyframes oliver-settle {
    0% {
      transform: scale(1);
    }
    40% {
      transform: scale(0.94);
    }
    70% {
      transform: scale(1.03);
    }
    100% {
      transform: scale(1);
    }
  }

  .oliver-visual:not(.oliver-sleeping) .oliver-svg {
    animation: oliver-breathe 3.6s ease-in-out infinite;
    transform-origin: 50% 85%;
  }

  .oliver-visual.oliver-sleeping .oliver-svg {
    animation: oliver-breathe-slow 4.8s ease-in-out infinite;
    transform-origin: 50% 85%;
  }

  .oliver-visual[data-reaction="play"] .oliver-svg {
    animation: oliver-breathe 3.6s ease-in-out infinite, oliver-bounce 700ms ease-in-out 1;
  }

