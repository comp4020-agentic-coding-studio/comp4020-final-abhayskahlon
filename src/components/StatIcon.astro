---
// One small line-icon per shared stat, mirroring ActionIcon.astro's visual
// language exactly (same viewBox, stroke width, cap/join style) so the two
// icon sets read as one consistent system. Purely decorative — the stat's
// real accessible label is the adjacent text, so this stays aria-hidden.
interface Props {
  stat: "hunger" | "energy" | "happiness" | "cleanliness";
  class?: string;
}

const { stat, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    stat === "hunger" && (
      <>
        {/* fullness: the same little bowl as the feed action, for a direct visual link */}
        <path d="M4 12.5a8 8 0 0 0 16 0" />
        <path d="M3.5 12.5h17" />
        <path d="M6.5 12.5c0-2.2 0-4 1.2-5.3" />
      </>
    )
  }
  {
    stat === "energy" && (
      <>
        {/* a small bolt */}
        <path d="M13 3 6 13.5h5L10.5 21 18 10h-5z" stroke-linejoin="round" />
      </>
    )
  }
  {
    stat === "happiness" && (
      <>
        {/* a simple heart */}
        <path d="M12 19.5s-7-4.4-9-8.6C1.5 7.4 3.5 4.5 6.7 4.5c2 0 3.5 1.1 4.3 2.6.8-1.5 2.3-2.6 4.3-2.6 3.2 0 5.2 2.9 3.7 6.4-2 4.2-9 8.6-9 8.6z" />
      </>
    )
  }
  {
    stat === "cleanliness" && (
      <>
        {/* a droplet with a small sparkle */}
        <path d="M12 3.5c2.8 3.4 5 6.6 5 9.5a5 5 0 0 1-10 0c0-2.9 2.2-6.1 5-9.5z" />
      </>
    )
  }
</svg>
