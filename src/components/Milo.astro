---
// Milo's visual identity — a single inline SVG creature, no external asset
// files (none exist in this repo; see PROCESS.md/CLAUDE.md, "Milo" is a
// fixed literal, not a naming feature, and this component never invents a
// mechanic — every expression below is read straight off the real `stats`
// and `activity` fields already shown as numbers/text elsewhere on this
// page).
//
// Rendered entirely server-side: which face to draw is a plain conditional
// picked from props, with no client script of its own. That means this
// component gets a free, correct re-render every time #live-state is
// swapped by refreshLiveState() (src/pages/index.astro) — the same path an
// SSE "update" triggers for everyone else — with nothing new to wire up for
// the steady-state expression.
//
// The one thing that *is* client-driven is the brief post-action reaction
// (crumbs/sparkles/bubbles/motion-lines/settle), and that's deliberately
// NOT a prop: index.astro's script toggles a `data-reaction` attribute on
// `.milo-visual` for ~1.6s after its own successful action, and the CSS
// below just reveals the matching always-rendered (but hidden-by-default)
// group while that attribute is present. See index.astro's script for why
// that attribute can only ever be set by the tab whose own action actually
// succeeded.
//
// Redesigned (reported directly, against a reference puppy illustration):
// the previous silhouette — one round body plus two small, mismatched ear
// shapes tucked almost entirely behind it — read as "a generic rounded
// creature," not specifically a dog. The root cause was the ears: at
// rx 15/18 against a body spanning roughly x=26 to x=134, both earlier ear
// shapes were narrower than the body itself and sat almost fully behind
// it, so neither one was ever visible as its own shape. The new ears are
// large floppy teardrops, anchored high on the head and drooping down and
// OUTWARD well past the body's own width (confirmed by rendering several
// candidate sizes before choosing — a true puppy needs a real, visible
// sliver of ear on both sides, not a hint of color at the body's edge).
// Also new: a distinct cream muzzle/forehead blaze (the thing that
// actually reads as "dog" rather than "bear," which the old uniform-color
// body never had at all), a small dark nose, and an open, happy mouth with
// a visible pink tongue for the two warmest moods. The body silhouette
// itself (the path below) is intentionally UNCHANGED from before — it was
// never the problem, and reusing it keeps Milo's proportions consistent
// with the other four appearances' own body-path conventions.
import type { Activity, HatOption, NeckwearOption, Stats } from "../lib/creature";
import { computeMood } from "./mood";

interface Props {
  activity: Activity;
  stats: Stats;
  hat?: HatOption | null;
  neckwear?: NeckwearOption | null;
  glasses?: string | null;
}

const { activity, stats, hat = null, neckwear = null, glasses = null } = Astro.props;
const sleeping = activity === "sleeping";
const { family, severe } = computeMood(stats, activity);

// A small 4-point sparkle, parametrised so excited's ambient twinkle and
// the play/clean reaction marks can share one shape definition rather than
// three hand-typed near-duplicates.
function sparkle(cx: number, cy: number, r: number): string {
  const inner = r * 0.22;
  return `M${cx} ${cy - r} L${cx + inner} ${cy - inner} L${cx + r} ${cy} L${cx + inner} ${cy + inner} L${cx} ${cy + r} L${cx - inner} ${cy + inner} L${cx - r} ${cy} L${cx - inner} ${cy - inner} Z`;
}
---

<div class={`milo-visual milo-${family}`} data-severe={severe ? "true" : "false"}>
  <svg viewBox="0 0 160 160" class="milo-svg" role="img" aria-label={`Milo, ${sleeping ? "asleep" : family}`}>
    <!-- stubby feet with small paw pads, drawn first so the body overlaps their tops -->
    <ellipse class="milo-foot" cx="58" cy="144" rx="11" ry="6" />
    <ellipse class="milo-foot" cx="102" cy="144" rx="11" ry="6" />
    <ellipse class="milo-paw-pad" cx="58" cy="145" rx="3.5" ry="2.2" />
    <ellipse class="milo-paw-pad" cx="102" cy="145" rx="3.5" ry="2.2" />

    <!-- tail, peeking from behind the body -->
    <path class="milo-tail" d="M126 108c17-3 22 13 10 19-8 4-15-2-13-11 1-4 1-6 3-8z" />

    <!-- floppy puppy ears: large teardrops anchored high on the head,
         drooping down and OUTWARD past the body's own width so a real,
         visible ear shows on both sides — the main fix for the original
         "generic round creature" problem (see comment above). A
         deliberately darker tan than the body/head so the ears read as
         their own feature, not just more of the same fill color. This
         silhouette never changes between expressions. -->
    <path
      class="milo-ear"
      d="M44 30c-26 0-44 22-40 48 3 18 15 32 30 36 -8-20-12-40-6-58 4-12 10-20 16-26z"
    />
    <path
      class="milo-ear"
      d="M116 30c26 0 44 22 40 48 -3 18-15 32-30 36 8-20 12-40 6-58 -4-12-10-20-16-26z"
    />

    <!-- body: unchanged from before — this was never the part of the
         silhouette that read wrong, and keeping it keeps Milo's overall
         proportions consistent with the other four appearances. -->
    <path
      class="milo-body-fill"
      d="M80 18c31 0 52 24 54 57 2 27-10 55-37 63-11 3-23 3-34 0-27-8-39-36-37-63 2-33 23-57 54-57z"
    />

    <!-- belly marking: one consistent detail across every state -->
    <ellipse class="milo-belly" cx="80" cy="102" rx="26" ry="29" />

    <!-- cream muzzle: a distinct, lighter shape around the nose/mouth —
         the single detail most responsible for reading as "dog" rather
         than "bear," which the previous uniform-tan body never had. -->
    <ellipse class="milo-muzzle" cx="80" cy="86" rx="23" ry="19" />

    <!-- a soft cream forehead blaze between the eyes, a small extra detail
         matching the reference's own light marking above the muzzle. -->
    <path
      class="milo-blaze"
      d="M80 44c-5 6-7 14-5 22 2-2 4-3 5-3s3 1 5 3c2-8 0-16-5-22z"
    />

    <!-- cheeks -->
    <ellipse class="milo-cheek" cx="55" cy="86" rx="7" ry="4.5" />
    <ellipse class="milo-cheek" cx="105" cy="86" rx="7" ry="4.5" />

    <!-- wardrobe: shared, cosmetic, always reflecting the one real stored
         choice (see src/lib/schema.ts's hat/neckwear columns) — never a
         per-viewer preference, never a second copy of state. Sits clear of
         both ears and the face group below. -->
    {
      hat === "top-hat" && (
        <g class="milo-wardrobe milo-hat-top" aria-hidden="true">
          <path d="M64 23c0-11 7-19 16-19s16 8 16 19z" />
          <ellipse cx="80" cy="23" rx="20" ry="4" />
          <rect x="65" y="14" width="30" height="5" />
        </g>
      )
    }
    {
      hat === "party-hat" && (
        <g class="milo-wardrobe milo-hat-party" aria-hidden="true">
          <path d="M80 3 L65 26 L95 26 Z" />
          <path d="M80 3 L75 14 L85 14 Z" class="milo-hat-party-stripe" />
          <circle cx="80" cy="3" r="3" class="milo-hat-party-pom" />
        </g>
      )
    }
    {
      hat === "beanie" && (
        <g class="milo-wardrobe milo-beanie" aria-hidden="true">
          <path d="M62 24c0-12 8-21 18-21s18 9 18 21z" />
          <rect x="60" y="20" width="40" height="7" rx="3" />
          <circle cx="80" cy="3" r="4" class="milo-beanie-pom" />
        </g>
      )
    }
    {
      hat === "bunny-ears" && (
        <g class="milo-wardrobe milo-bunny-ears" aria-hidden="true">
          <ellipse cx="64" cy="-6" rx="8" ry="28" transform="rotate(-8 64 -6)" />
          <ellipse cx="96" cy="-6" rx="8" ry="28" transform="rotate(8 96 -6)" />
          <ellipse class="milo-bunny-ears-inner" cx="64" cy="-6" rx="4" ry="20" transform="rotate(-8 64 -6)" />
          <ellipse class="milo-bunny-ears-inner" cx="96" cy="-6" rx="4" ry="20" transform="rotate(8 96 -6)" />
        </g>
      )
    }
    {
      hat === "wizard-hat" && (
        <g class="milo-wardrobe milo-wizard-hat" aria-hidden="true">
          <path d="M80 -2 L62 26 L98 26 Z" />
          <ellipse cx="80" cy="26" rx="22" ry="4" />
          <circle cx="76" cy="14" r="1.6" class="milo-wizard-star" />
          <circle cx="86" cy="8" r="1.3" class="milo-wizard-star" />
        </g>
      )
    }
    {
      hat === "golden-crown" && (
        <g class="milo-wardrobe milo-golden-crown" aria-hidden="true">
          <path d="M60 24 L66 8 L74 18 L80 4 L86 18 L94 8 L100 24 Z" />
          <rect x="60" y="22" width="40" height="6" rx="2" />
          <circle cx="80" cy="4" r="2.4" class="milo-crown-gem" />
        </g>
      )
    }
    {
      neckwear === "bow-tie" && (
        <g class="milo-wardrobe milo-bow-tie" aria-hidden="true">
          <path d="M80 108 L68 102 L68 114 Z" />
          <path d="M80 108 L92 102 L92 114 Z" />
          <circle cx="80" cy="108" r="3.2" class="milo-bow-knot" />
        </g>
      )
    }
    {
      neckwear === "scarf" && (
        <g class="milo-wardrobe milo-scarf" aria-hidden="true">
          <path d="M57 106c6 8 40 8 46 0l-2 9c-11 5-31 5-42 0z" />
          <path d="M90 112l8 16-10 1-5-15z" class="milo-scarf-tail" />
        </g>
      )
    }
    {
      neckwear === "knit-scarf" && (
        <g class="milo-wardrobe milo-knit-scarf" aria-hidden="true">
          <path d="M55 106c7 9 43 9 50 0l-2 10c-13 6-33 6-46 0z" />
          <path d="M88 115l6 18-9 1-5-17z" class="milo-knit-scarf-tail" />
        </g>
      )
    }

    {
      sleeping ? (
        <g class="milo-face milo-face-sleeping">
          <path class="milo-eye-line" d="M51 67c4-4 11-4 15 0" />
          <path class="milo-eye-line" d="M88 67c4-4 11-4 15 0" />
          <ellipse class="milo-nose" cx="80" cy="81" rx="5.5" ry="4" />
          <path class="milo-mouth" d="M72 90c5 4 11 4 16 0" />
          <g class="milo-zzz" aria-hidden="true">
            <text x="112" y="46" class="milo-zzz-char milo-zzz-1">z</text>
            <text x="124" y="34" class="milo-zzz-char milo-zzz-2">z</text>
            <text x="136" y="23" class="milo-zzz-char milo-zzz-3">z</text>
          </g>
        </g>
      ) : family === "happy" ? (
        <g class="milo-face">
          <ellipse class="milo-eye" cx="63" cy="68" rx="7.2" ry="8.3" />
          <ellipse class="milo-eye" cx="97" cy="68" rx="6.3" ry="7.3" />
          <circle class="milo-eye-highlight" cx="65.5" cy="64" r="2.3" />
          <circle class="milo-eye-highlight" cx="99" cy="64.3" r="2" />
          <ellipse class="milo-nose" cx="80" cy="81" rx="5.5" ry="4" />
          <ellipse class="milo-nose-shine" cx="78.5" cy="79.5" rx="1.3" ry="0.9" />
          <path class="milo-tongue-stem" d="M80 85v3.5" />
          <path class="milo-mouth" d="M66 89c3 7 9 10 14 10s11-3 14-10" />
          <path class="milo-tongue" d="M73 93.5c2 3.5 5 5 7 5s5-1.5 7-5c0 4-3 8-7 8s-7-4-7-8z" />
        </g>
      ) : family === "excited" ? (
        <g class="milo-face">
          <ellipse class="milo-eye" cx="63" cy="67.5" rx="7.6" ry="8.8" />
          <ellipse class="milo-eye" cx="97" cy="67.5" rx="6.7" ry="7.8" />
          <circle class="milo-eye-highlight" cx="65.7" cy="63.3" r="2.6" />
          <circle class="milo-eye-highlight" cx="99.4" cy="63.7" r="2.3" />
          <ellipse class="milo-nose" cx="80" cy="80.5" rx="5.5" ry="4" />
          <ellipse class="milo-nose-shine" cx="78.5" cy="79" rx="1.3" ry="0.9" />
          <path class="milo-tongue-stem" d="M80 84.5v3.5" />
          <path class="milo-mouth" d="M63 88c4 9 11 13 17 13s13-4 17-13" />
          <path class="milo-tongue" d="M72 93c2 4.5 6 6.5 8 6.5s6-2 8-6.5c0 5-3.5 10-8 10s-8-5-8-10z" />
          <g class="milo-sparkle-ambient" aria-hidden="true">
            <path d={sparkle(18, 44, 6.5)} />
            <path d={sparkle(136, 38, 6)} />
          </g>
        </g>
      ) : family === "sleepy" ? (
        <g class="milo-face">
          {/* Closed, drowsy eyes drawn as a simple curved LINE (matching
              every other mood's eye-closed/squint treatment elsewhere in
              this file), not a filled dark shape — a filled eyelid this
              close to the nose below it is what previously read as a
              solid dark bar across the upper face. */}
          <path class="milo-eye-line" d="M55 68c3.5-3 10.5-3 14 0" />
          <path class="milo-eye-line" d="M91 68c3.5-3 10.5-3 14 0" />
          <ellipse class="milo-nose" cx="80" cy="82" rx="5.5" ry="4" />
          {severe ? (
            <>
              {/* Spaced well clear of the nose above it (previously only
                  ~3 SVG units apart, which collapsed into one dark blob at
                  the creature's actual small rendered size — found only by
                  rendering, not by reading the coordinates). */}
              <ellipse class="milo-mouth-open" cx="80" cy="99" rx="6" ry="5" />
              <text x="100" y="60" class="milo-zzz-char milo-zzz-solo">z</text>
            </>
          ) : (
            <path class="milo-mouth" d="M70 93c4 2 16 2 20 0" />
          )}
        </g>
      ) : family === "hungry" ? (
        <g class="milo-face">
          <path class="milo-brow-up" d="M53 58c3-3 9-3 12-1" />
          <path class="milo-brow-up" d="M95 57c3-3 9-3 12 1" />
          <ellipse class="milo-eye" cx="63" cy="69" rx="7.6" ry="8" />
          <ellipse class="milo-eye" cx="97" cy="69" rx="6.7" ry="7" />
          <circle class="milo-eye-highlight" cx="65.5" cy="65.5" r="2.4" />
          <circle class="milo-eye-highlight" cx="99" cy="65.9" r="2.1" />
          <ellipse class="milo-nose" cx="80" cy="82" rx="5.5" ry="4" />
          <path class="milo-mouth" d="M70 92c3-3 9 3 12 0c3-3 9 3 12 0" />
          {severe && <path class="milo-rumble" d="M68 96c4-6 8 6 12 0s8-6 12 0" />}
        </g>
      ) : family === "sad" ? (
        <g class="milo-face">
          <path class="milo-brow-down" d="M53 60c3 3 9 4 12 2" />
          <path class="milo-brow-down" d="M95 62c3-2 9-3 12-1" />
          <ellipse class="milo-eye" cx="63" cy="69" rx="6.5" ry="6.9" />
          <ellipse class="milo-eye" cx="97" cy="69" rx="5.8" ry="6.2" />
          <ellipse class="milo-nose" cx="80" cy="82" rx="5.5" ry="4" />
          <path class="milo-mouth" d="M67 94c7-8 19-8 26 0" />
          {severe && (
            <g class="milo-cloud" aria-hidden="true">
              <path d="M58 16c-5 0-8 3-9 6-4 1-7 4-7 8 0 4 4 7 8 7h23c4 0 7-3 7-7 0-3-2-6-5-7 0-5-4-9-9-9-3 0-6 1-8 2z" />
              <path class="milo-raindrop milo-raindrop-1" d="M58 40v5" />
              <path class="milo-raindrop milo-raindrop-2" d="M70 42v5" />
            </g>
          )}
        </g>
      ) : (
        <g class="milo-face">
          <path class="milo-eye-line milo-eye-squint" d="M53 68c3.5-3.5 10.5-3.5 14 0" />
          <ellipse class="milo-eye" cx="97" cy="69" rx="5.8" ry="6.2" />
          <circle class="milo-eye-highlight" cx="99" cy="66.5" r="1.6" />
          <ellipse class="milo-nose" cx="80" cy="82" rx="5.5" ry="4" />
          <path class="milo-mouth" d="M72 92c4 3 12 3 16 0" />
          <g class="milo-dirt" aria-hidden="true">
            <ellipse cx="60" cy="108" rx="2.6" ry="1.8" transform="rotate(20 60 108)" />
            <ellipse cx="98" cy="112" rx="2.2" ry="1.6" transform="rotate(-15 98 112)" />
            <ellipse cx="72" cy="119" rx="2" ry="1.5" />
            <ellipse cx="102" cy="101" rx="1.8" ry="1.4" />
          </g>
          {severe && (
            <>
              <path class="milo-stink milo-stink-1" d="M26 68c-2-4 2-6 0-10s2-6 0-10" />
              <path class="milo-stink milo-stink-2" d="M136 64c2-4-2-6 0-10s-2-6 0-10" />
            </>
          )}
        </g>
      )
    }

    {/* Glasses render AFTER the face, not alongside hat/neckwear above:
        they occupy the same screen area as the eyes, so drawing them
        earlier let the face's own eye shapes paint over them, hiding them
        entirely — found and fixed during visual verification, not assumed
        correct from reading the code alone. Repositioned to the new,
        slightly higher eye line (cy≈68, was 76) so they still sit directly
        over the eyes rather than floating below them. */}
    {
      glasses === "round-glasses" && (
        <g class="milo-wardrobe milo-round-glasses" aria-hidden="true">
          <circle cx="63" cy="68" r="9" />
          <circle cx="97" cy="68" r="9" />
          <path d="M72 68h16" />
        </g>
      )
    }
    {
      glasses === "heart-glasses" && (
        <g class="milo-wardrobe milo-heart-glasses" aria-hidden="true">
          <path d="M63 63c-3-3-8-2-8 2 0 3 4 6 8 9 4-3 8-6 8-9 0-4-5-5-8-2z" />
          <path d="M97 63c-3-3-8-2-8 2 0 3 4 6 8 9 4-3 8-6 8-9 0-4-5-5-8-2z" />
          <path d="M71 68h18" />
        </g>
      )
    }

    <!-- Reaction marks: always rendered, invisible until index.astro's
         script sets data-reaction="<action>" on .milo-visual for ~1.6s
         after a confirmed successful action in THIS tab. Purely additive —
         never replaces the face above, exactly so "brief reaction, then
         back to the real expression" needs no extra logic here. -->
    <g class="milo-reaction milo-reaction-feed" aria-hidden="true">
      <circle cx="66" cy="108" r="3.2" />
      <circle cx="94" cy="110" r="2.6" />
      <circle cx="80" cy="116" r="2.3" />
    </g>
    <g class="milo-reaction milo-reaction-play" aria-hidden="true">
      <path d={sparkle(36, 58, 7)} />
      <path d={sparkle(124, 54, 6)} />
      <path d={sparkle(80, 28, 5)} />
    </g>
    <g class="milo-reaction milo-reaction-walk" aria-hidden="true">
      <path d="M24 136c-4 1-6 4-6 7" />
      <path d="M19 125c-4 1-7 3-8 6" />
      <path d="M27 147c-4 0-7 2-8 5" />
    </g>
    <g class="milo-reaction milo-reaction-clean" aria-hidden="true">
      <circle class="milo-bubble" cx="38" cy="68" r="4" />
      <circle class="milo-bubble" cx="125" cy="58" r="3" />
      <circle class="milo-bubble" cx="119" cy="94" r="2.4" />
      <path d={sparkle(80, 54, 5)} />
    </g>
    <g class="milo-reaction milo-reaction-adventure" aria-hidden="true">
      <ellipse class="milo-mud" cx="58" cy="118" rx="6" ry="3.5" transform="rotate(-10 58 118)" />
      <ellipse class="milo-mud" cx="100" cy="124" rx="5" ry="3" transform="rotate(8 100 124)" />
      <ellipse class="milo-mud" cx="78" cy="132" rx="4" ry="2.4" />
    </g>
  </svg>
</div>

<style>
  .milo-visual {
    position: relative;
    display: inline-block;
    width: clamp(7.5rem, 24vw, 10.5rem);
    margin: 0 auto;
  }

  .milo-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .milo-body-fill {
    fill: var(--milo-body, #f0b374);
    stroke: var(--milo-outline, #6b4a2f);
    stroke-width: 3;
    stroke-linejoin: round;
  }

  .milo-foot {
    fill: var(--milo-body, #f0b374);
    stroke: var(--milo-outline, #6b4a2f);
    stroke-width: 3;
  }

  .milo-paw-pad {
    fill: var(--milo-ear, #c88a52);
  }

  .milo-tail {
    fill: var(--milo-body, #f0b374);
    stroke: var(--milo-outline, #6b4a2f);
    stroke-width: 3;
    stroke-linejoin: round;
  }

  /* Deliberately a darker tan than the body/head fill, not the same color
     — this is what makes the ears read as their own feature rather than
     disappearing into the rest of the silhouette. */
  .milo-ear {
    fill: var(--milo-ear, #c88a52);
    stroke: var(--milo-outline, #6b4a2f);
    stroke-width: 3;
    stroke-linejoin: round;
  }

  .milo-belly {
    fill: var(--milo-belly, #ffd9b8);
    stroke: none;
  }

  .milo-muzzle {
    fill: var(--milo-muzzle, #fdf0da);
    stroke: var(--milo-outline, #6b4a2f);
    stroke-width: 2;
  }

  .milo-blaze {
    fill: var(--milo-muzzle, #fdf0da);
    opacity: 0.85;
  }

  .milo-cheek {
    fill: #ff8fa3;
    opacity: 0.45;
    transform-origin: center;
  }

  .milo-nose {
    fill: var(--milo-nose, #2b2420);
  }

  .milo-nose-shine {
    fill: #fff;
    opacity: 0.6;
  }

  /* Warm brown eyes, distinct from the darker outline color — large eyes
     filled with the same near-black tone as the linework is what reads as
     a dominating dark mask, independent of how big the eyes themselves are. */
  .milo-eye {
    fill: var(--milo-eye, #4a3220);
  }

  .milo-eye-line,
  .milo-eye-squint {
    fill: none;
    stroke: var(--milo-eye, #4a3220);
    stroke-width: 3;
    stroke-linecap: round;
  }

  .milo-eye-bag,
  .milo-brow-up,
  .milo-brow-down,
  .milo-rumble,
  .milo-stink {
    fill: none;
    stroke: var(--milo-outline, #6b4a2f);
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0.55;
  }

  .milo-eye-highlight {
    fill: #fff;
  }

  .milo-mouth,
  .milo-tongue-stem {
    fill: none;
    stroke: var(--milo-outline, #6b4a2f);
    stroke-width: 2;
    stroke-linecap: round;
