---
// Simbaa's visual identity — a baby lamb, one of the five fixed, authored
// appearances the room's one shared creature can switch between
// (PROCESS.md, Decision 15). A self-contained sibling of Milo.astro: same
// Props shape, same mood-driven face branching via the already
// species-agnostic computeMood() (src/components/mood.ts), same
// always-rendered-but-hidden reaction-mark pattern, same scoped-style
// approach — deliberately NOT refactored into a shared base component with
// Milo.astro (see PROCESS.md, Decision 15, "no premature abstraction").
//
// Distinguishing silhouette: a fluffy, scalloped wool outline around the
// body, small rounded drop ears, short thin legs, a pink muzzle patch.
import type { Activity, Stats } from "../lib/creature";
import { computeMood } from "./mood";

interface Props {
  activity: Activity;
  stats: Stats;
  hat?: string | null;
  neckwear?: string | null;
  glasses?: string | null;
}

const { activity, stats, hat = null, neckwear = null, glasses = null } = Astro.props;
const sleeping = activity === "sleeping";
const { family, severe } = computeMood(stats, activity);

function sparkle(cx: number, cy: number, r: number): string {
  const inner = r * 0.22;
  return `M${cx} ${cy - r} L${cx + inner} ${cy - inner} L${cx + r} ${cy} L${cx + inner} ${cy + inner} L${cx} ${cy + r} L${cx - inner} ${cy + inner} L${cx - r} ${cy} L${cx - inner} ${cy - inner} Z`;
}
---

<div class={`simbaa-visual simbaa-${family}`} data-severe={severe ? "true" : "false"}>
  <svg viewBox="0 0 160 160" class="simbaa-svg" role="img" aria-label={`Simbaa, ${sleeping ? "asleep" : family}`}>
    <!-- stubby legs, same footprint as Milo's feet so the body sits on them
         with no visible gap -->
    <rect class="simbaa-leg" x="52" y="128" width="11" height="20" rx="5" />
    <rect class="simbaa-leg" x="97" y="128" width="11" height="20" rx="5" />

    <!-- small drop ears, tucked behind the body so the wool reads as the
         primary silhouette -->
    <ellipse class="simbaa-ear" cx="42" cy="50" rx="10" ry="16" transform="rotate(-25 42 50)" />
    <ellipse class="simbaa-ear" cx="118" cy="50" rx="10" ry="16" transform="rotate(25 118 50)" />

    <!-- fluffy wool body: the same proven oval silhouette Milo's body uses
         (so it sits correctly on the legs above with no gap), with small
         scalloped bumps layered around the outline so it reads as "wool"
         rather than a plain rounded pet shape. -->
    <path
      class="simbaa-wool"
      d="M80 18c31 0 52 24 54 57 2 27-10 55-37 63-11 3-23 3-34 0-27-8-39-36-37-63 2-33 23-57 54-57z"
    />
    <g class="simbaa-wool-scallops" aria-hidden="true">
      <circle cx="46" cy="34" r="9" />
      <circle cx="68" cy="20" r="9" />
      <circle cx="92" cy="20" r="9" />
      <circle cx="114" cy="34" r="9" />
      <circle cx="32" cy="56" r="8" />
      <circle cx="128" cy="56" r="8" />
      <circle cx="30" cy="82" r="7" />
      <circle cx="130" cy="82" r="7" />
      <circle cx="38" cy="108" r="7" />
      <circle cx="122" cy="108" r="7" />
    </g>

    <!-- belly marking -->
    <ellipse class="simbaa-belly" cx="80" cy="104" rx="24" ry="26" />

    <!-- pink muzzle patch -->
    <ellipse class="simbaa-muzzle" cx="80" cy="100" rx="17" ry="13" />

    <!-- cheeks -->
    <ellipse class="simbaa-cheek" cx="54" cy="90" rx="8" ry="5" />
    <ellipse class="simbaa-cheek" cx="106" cy="90" rx="8" ry="5" />

    {
      hat === "top-hat" && (
        <g class="simbaa-wardrobe simbaa-hat-top" aria-hidden="true">
          <path d="M64 23c0-11 7-19 16-19s16 8 16 19z" />
          <ellipse cx="80" cy="23" rx="20" ry="4" />
          <rect x="65" y="14" width="30" height="5" />
        </g>
      )
    }
    {
      hat === "party-hat" && (
        <g class="simbaa-wardrobe simbaa-hat-party" aria-hidden="true">
          <path d="M80 3 L65 26 L95 26 Z" />
          <path d="M80 3 L75 14 L85 14 Z" class="simbaa-hat-party-stripe" />
          <circle cx="80" cy="3" r="3" class="simbaa-hat-party-pom" />
        </g>
      )
    }
    {
      hat === "beanie" && (
        <g class="simbaa-wardrobe simbaa-beanie" aria-hidden="true">
          <path d="M62 24c0-12 8-21 18-21s18 9 18 21z" />
          <rect x="60" y="20" width="40" height="7" rx="3" />
          <circle cx="80" cy="3" r="4" class="simbaa-beanie-pom" />
        </g>
      )
    }
    {
      hat === "bunny-ears" && (
        <g class="simbaa-wardrobe simbaa-bunny-ears" aria-hidden="true">
          <ellipse cx="64" cy="-6" rx="8" ry="28" transform="rotate(-8 64 -6)" />
          <ellipse cx="96" cy="-6" rx="8" ry="28" transform="rotate(8 96 -6)" />
          <ellipse class="simbaa-bunny-ears-inner" cx="64" cy="-6" rx="4" ry="20" transform="rotate(-8 64 -6)" />
          <ellipse class="simbaa-bunny-ears-inner" cx="96" cy="-6" rx="4" ry="20" transform="rotate(8 96 -6)" />
        </g>
      )
    }
    {
      hat === "wizard-hat" && (
        <g class="simbaa-wardrobe simbaa-wizard-hat" aria-hidden="true">
          <path d="M80 -2 L62 26 L98 26 Z" />
          <ellipse cx="80" cy="26" rx="22" ry="4" />
          <circle cx="76" cy="14" r="1.6" class="simbaa-wizard-star" />
          <circle cx="86" cy="8" r="1.3" class="simbaa-wizard-star" />
        </g>
      )
    }
    {
      hat === "golden-crown" && (
        <g class="simbaa-wardrobe simbaa-golden-crown" aria-hidden="true">
          <path d="M60 24 L66 8 L74 18 L80 4 L86 18 L94 8 L100 24 Z" />
          <rect x="60" y="22" width="40" height="6" rx="2" />
          <circle cx="80" cy="4" r="2.4" class="simbaa-crown-gem" />
        </g>
      )
    }
    {
      neckwear === "bow-tie" && (
        <g class="simbaa-wardrobe simbaa-bow-tie" aria-hidden="true">
          <path d="M80 110 L68 104 L68 116 Z" />
          <path d="M80 110 L92 104 L92 116 Z" />
          <circle cx="80" cy="110" r="3.2" class="simbaa-bow-knot" />
        </g>
      )
    }
    {
      neckwear === "scarf" && (
        <g class="simbaa-wardrobe simbaa-scarf" aria-hidden="true">
          <path d="M57 108c6 8 40 8 46 0l-2 9c-11 5-31 5-42 0z" />
          <path d="M90 114l8 16-10 1-5-15z" class="simbaa-scarf-tail" />
        </g>
      )
    }
    {
      neckwear === "knit-scarf" && (
        <g class="simbaa-wardrobe simbaa-knit-scarf" aria-hidden="true">
          <path d="M55 109c7 9 43 9 50 0l-2 10c-13 6-33 6-46 0z" />
          <path d="M88 118l6 18-9 1-5-17z" class="simbaa-knit-scarf-tail" />
        </g>
      )
    }

    {
      sleeping ? (
        <g class="simbaa-face simbaa-face-sleeping">
          <path class="simbaa-eye-line" d="M50 76c5-5 13-5 18 0" />
          <path class="simbaa-eye-line" d="M92 76c5-5 13-5 18 0" />
          <path class="simbaa-mouth" d="M72 102c5 4 11 4 16 0" />
          <g class="simbaa-zzz" aria-hidden="true">
            <text x="112" y="50" class="simbaa-zzz-char simbaa-zzz-1">z</text>
            <text x="124" y="38" class="simbaa-zzz-char simbaa-zzz-2">z</text>
            <text x="136" y="27" class="simbaa-zzz-char simbaa-zzz-3">z</text>
          </g>
        </g>
      ) : family === "happy" ? (
        <g class="simbaa-face">
          <ellipse class="simbaa-eye" cx="58" cy="78" rx="9.5" ry="10.5" />
          <ellipse class="simbaa-eye" cx="102" cy="78" rx="8" ry="9" />
          <circle class="simbaa-eye-highlight" cx="61" cy="73.5" r="2.5" />
          <circle class="simbaa-eye-highlight" cx="104" cy="74" r="2.1" />
          <path class="simbaa-mouth" d="M66 102c6 7 22 7 28 0" />
        </g>
      ) : family === "excited" ? (
        <g class="simbaa-face">
          <ellipse class="simbaa-eye" cx="58" cy="78" rx="10" ry="11" />
          <ellipse class="simbaa-eye" cx="102" cy="78" rx="8.5" ry="9.5" />
          <circle class="simbaa-eye-highlight" cx="61" cy="73" r="2.8" />
          <circle class="simbaa-eye-highlight" cx="104.5" cy="73.5" r="2.4" />
          <path class="simbaa-mouth" d="M62 101c7 10 29 10 36 0" />
          <g class="simbaa-sparkle-ambient" aria-hidden="true">
            <path d={sparkle(18, 48, 6.5)} />
            <path d={sparkle(136, 42, 6)} />
          </g>
        </g>
      ) : family === "sleepy" ? (
        <g class="simbaa-face">
          <path class="simbaa-eye-lid" d="M49 74c4-3 14-3 18 0l-1 6c-4 2-12 2-16 0z" />
          <path class="simbaa-eye-lid" d="M93 74c4-3 13-3 17 0l-1 6c-4 2-11 2-15 0z" />
          {severe ? (
            <>
              <ellipse class="simbaa-mouth-open" cx="80" cy="104" rx="6" ry="5" />
              <text x="100" y="68" class="simbaa-zzz-char simbaa-zzz-solo">z</text>
            </>
          ) : (
            <path class="simbaa-mouth" d="M70 103c4 2 16 2 20 0" />
          )}
        </g>
      ) : family === "hungry" ? (
        <g class="simbaa-face">
          <path class="simbaa-brow-up" d="M50 67c3-3 9-3 12-1" />
          <path class="simbaa-brow-up" d="M98 66c3-3 9-3 12 1" />
          <ellipse class="simbaa-eye" cx="58" cy="80" rx="10" ry="10.5" />
          <ellipse class="simbaa-eye" cx="102" cy="80" rx="8.5" ry="9" />
          <circle class="simbaa-eye-highlight" cx="61" cy="76" r="2.6" />
          <circle class="simbaa-eye-highlight" cx="104.5" cy="76.5" r="2.1" />
          <path class="simbaa-mouth" d="M70 104c3-3 9 3 12 0c3-3 9 3 12 0" />
          {severe && <path class="simbaa-rumble" d="M68 108c4-6 8 6 12 0s8-6 12 0" />}
        </g>
      ) : family === "sad" ? (
        <g class="simbaa-face">
          <path class="simbaa-brow-down" d="M50 69c3 3 9 4 12 2" />
          <path class="simbaa-brow-down" d="M98 71c3-2 9-3 12-1" />
          <ellipse class="simbaa-eye" cx="58" cy="80" rx="8.5" ry="9" />
          <ellipse class="simbaa-eye" cx="102" cy="80" rx="7.5" ry="8" />
          <path class="simbaa-mouth" d="M66 106c7-8 23-8 30 0" />
          {severe && (
            <g class="simbaa-cloud" aria-hidden="true">
              <path d="M58 18c-5 0-8 3-9 6-4 1-7 4-7 8 0 4 4 7 8 7h23c4 0 7-3 7-7 0-3-2-6-5-7 0-5-4-9-9-9-3 0-6 1-8 2z" />
              <path class="simbaa-raindrop simbaa-raindrop-1" d="M58 42v5" />
              <path class="simbaa-raindrop simbaa-raindrop-2" d="M70 44v5" />
            </g>
          )}
        </g>
      ) : (
        <g class="simbaa-face">
          <path class="simbaa-eye-line simbaa-eye-squint" d="M49 77c4-4 13-4 18 0" />
          <ellipse class="simbaa-eye" cx="102" cy="79" rx="7" ry="7.5" />
          <circle class="simbaa-eye-highlight" cx="104" cy="76" r="1.7" />
          <path class="simbaa-mouth" d="M72 102c4 3 12 3 16 0" />
          <g class="simbaa-dirt" aria-hidden="true">
            <ellipse cx="64" cy="118" rx="2.6" ry="1.8" transform="rotate(20 64 118)" />
            <ellipse cx="94" cy="122" rx="2.2" ry="1.6" transform="rotate(-15 94 122)" />
            <ellipse cx="74" cy="129" rx="2" ry="1.5" />
          </g>
          {severe && (
            <>
              <path class="simbaa-stink simbaa-stink-1" d="M26 70c-2-4 2-6 0-10s2-6 0-10" />
              <path class="simbaa-stink simbaa-stink-2" d="M136 66c2-4-2-6 0-10s-2-6 0-10" />
            </>
          )}
        </g>
      )
    }

    {
      glasses === "round-glasses" && (
        <g class="simbaa-wardrobe simbaa-round-glasses" aria-hidden="true">
          <circle cx="58" cy="80" r="9" />
          <circle cx="102" cy="80" r="9" />
          <path d="M67 80h26" />
        </g>
      )
    }
    {
      glasses === "heart-glasses" && (
        <g class="simbaa-wardrobe simbaa-heart-glasses" aria-hidden="true">
          <path d="M58 75c-3-3-8-2-8 2 0 3 4 6 8 9 4-3 8-6 8-9 0-4-5-5-8-2z" />
          <path d="M102 75c-3-3-8-2-8 2 0 3 4 6 8 9 4-3 8-6 8-9 0-4-5-5-8-2z" />
          <path d="M66 80h28" />
        </g>
      )
    }

    <g class="simbaa-reaction simbaa-reaction-feed" aria-hidden="true">
      <circle cx="66" cy="112" r="3.2" />
      <circle cx="94" cy="114" r="2.6" />
      <circle cx="80" cy="120" r="2.3" />
    </g>
    <g class="simbaa-reaction simbaa-reaction-play" aria-hidden="true">
      <path d={sparkle(36, 60, 7)} />
      <path d={sparkle(124, 56, 6)} />
      <path d={sparkle(80, 30, 5)} />
    </g>
    <g class="simbaa-reaction simbaa-reaction-walk" aria-hidden="true">
      <path d="M24 136c-4 1-6 4-6 7" />
      <path d="M19 125c-4 1-7 3-8 6" />
      <path d="M27 147c-4 0-7 2-8 5" />
    </g>
    <g class="simbaa-reaction simbaa-reaction-clean" aria-hidden="true">
      <circle class="simbaa-bubble" cx="38" cy="70" r="4" />
      <circle class="simbaa-bubble" cx="125" cy="60" r="3" />
      <circle class="simbaa-bubble" cx="119" cy="96" r="2.4" />
      <path d={sparkle(80, 56, 5)} />
    </g>
    <g class="simbaa-reaction simbaa-reaction-adventure" aria-hidden="true">
      <ellipse class="simbaa-mud" cx="58" cy="120" rx="6" ry="3.5" transform="rotate(-10 58 120)" />
      <ellipse class="simbaa-mud" cx="100" cy="126" rx="5" ry="3" transform="rotate(8 100 126)" />
      <ellipse class="simbaa-mud" cx="78" cy="133" rx="4" ry="2.4" />
    </g>
  </svg>
</div>

<style>
  .simbaa-visual {
    position: relative;
    display: inline-block;
    width: clamp(7.5rem, 24vw, 10.5rem);
    margin: 0 auto;
  }

  .simbaa-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .simbaa-wool {
    fill: var(--simbaa-body, #fbf6ea);
    stroke: var(--simbaa-outline, #8a7a5c);
    stroke-width: 3;
    stroke-linejoin: round;
  }

  .simbaa-wool-scallops circle {
    fill: var(--simbaa-body, #fbf6ea);
    stroke: var(--simbaa-outline, #8a7a5c);
    stroke-width: 2;
  }

  .simbaa-ear {
    fill: var(--simbaa-ear, #e8c9a0);
    stroke: var(--simbaa-outline, #8a7a5c);
    stroke-width: 2.6;
  }

  .simbaa-leg {
    fill: var(--simbaa-ear, #e8c9a0);
    stroke: var(--simbaa-outline, #8a7a5c);
    stroke-width: 2.2;
  }

  .simbaa-belly {
    fill: var(--simbaa-belly, #fffdf6);
    stroke: none;
  }

  .simbaa-muzzle {
    fill: #f4c2b8;
    opacity: 0.8;
  }

  .simbaa-cheek {
    fill: #ff8fa3;
    opacity: 0.4;
    transform-origin: center;
  }

  .simbaa-eye,
  .simbaa-eye-lid {
    fill: var(--simbaa-outline, #5a4b32);
  }

  .simbaa-eye-line,
  .simbaa-eye-squint {
    fill: none;
    stroke: var(--simbaa-outline, #5a4b32);
    stroke-width: 3;
    stroke-linecap: round;
  }

  .simbaa-eye-bag,
  .simbaa-brow-up,
  .simbaa-brow-down,
  .simbaa-rumble,
  .simbaa-stink {
    fill: none;
    stroke: var(--simbaa-outline, #5a4b32);
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0.55;
  }

  .simbaa-eye-highlight {
    fill: #fff;
  }

  .simbaa-mouth {
    fill: none;
    stroke: var(--simbaa-outline, #5a4b32);
    stroke-width: 3;
    stroke-linecap: round;
  }

  .simbaa-mouth-open {
    fill: var(--simbaa-outline, #5a4b32);
    opacity: 0.85;
  }

  .simbaa-wardrobe {
    stroke: var(--simbaa-outline, #5a4b32);
    stroke-width: 1.6;
    stroke-linejoin: round;
  }

  .simbaa-hat-top {
    fill: #2b2420;
  }
  .simbaa-hat-party {
    fill: #ff8a5b;
  }
  .simbaa-hat-party-stripe {
    fill: #fff6d8;
  }
  .simbaa-hat-party-pom {
    fill: #ffcf6b;
  }
  .simbaa-beanie {
    fill: #5b8aa8;
  }
  .simbaa-beanie-pom {
    fill: #fff;
  }
  .simbaa-bunny-ears {
    fill: #f4ece0;
  }
  .simbaa-bunny-ears-inner {
    fill: #f4b8a8;
    stroke: none;
  }
  .simbaa-wizard-hat {
    fill: #5a3fae;
  }
  .simbaa-wizard-star {
    fill: #ffd76b;
    stroke: none;
  }
  .simbaa-golden-crown {
    fill: #f4c430;
  }
  .simbaa-crown-gem {
    fill: #c7453a;
    stroke: none;
  }
  .simbaa-round-glasses,
  .simbaa-heart-glasses {
    fill: none;
    stroke: #2b2420;
    stroke-width: 2.2;
  }
  .simbaa-bow-tie {
    fill: #c7453a;
  }
  .simbaa-bow-knot {
    fill: #9c342b;
    stroke: none;
  }
  .simbaa-scarf,
  .simbaa-scarf-tail {
    fill: #3f8f5f;
  }
  .simbaa-knit-scarf,
  .simbaa-knit-scarf-tail {
    fill: #6a4fae;
  }

  .simbaa-happy,
  .simbaa-excited {
    --simbaa-body: #fbf6ea;
    --simbaa-belly: #fffdf6;
    --simbaa-ear: #e8c9a0;
  }

  .simbaa-sleepy,
  .simbaa-sleeping {
    --simbaa-body: #e6e2d6;
    --simbaa-belly: #f3f1e9;
    --simbaa-ear: #d2c3a8;
  }

  .simbaa-hungry {
    --simbaa-body: #f3e6c8;
    --simbaa-belly: #f9f0d9;
    --simbaa-ear: #e0bd8e;
  }

  .simbaa-sad {
    --simbaa-body: #dde3ea;
    --simbaa-belly: #eef1f6;
    --simbaa-ear: #c3cedb;
  }

  .simbaa-messy {
    --simbaa-body: #d6c7a3;
    --simbaa-belly: #e8dcc0;
    --simbaa-ear: #a78a60;
  }

  .simbaa-sparkle-ambient path {
    fill: #ffcf6b;
  }

  .simbaa-cloud path:first-child {
    fill: #c6d3e2;
  }

  .simbaa-raindrop {
    stroke: #8fa9c9;
    stroke-width: 2.4;
    stroke-linecap: round;
    animation: simbaa-raindrop-fall 1.6s ease-in infinite;
  }

  .simbaa-raindrop-2 {
    animation-delay: 0.5s;
  }

  .simbaa-dirt ellipse {
    fill: #8a6a49;
    opacity: 0.6;
  }

  .simbaa-zzz-char {
    font: 700 1rem/1 ui-rounded, system-ui, sans-serif;
    fill: var(--color-muted);
  }

  .simbaa-zzz-solo {
    font-size: 0.75rem;
    opacity: 0.7;
    animation: simbaa-zzz-float 2.6s ease-in infinite;
  }

  .simbaa-reaction {
    opacity: 0;
  }

  .simbaa-reaction-feed circle {
    fill: #c98a4b;
  }

  .simbaa-reaction-play path {
    fill: #ffcf6b;
  }

  .simbaa-reaction-walk path {
    fill: none;
    stroke: var(--color-accent-ink, #b84b22);
    stroke-width: 2.2;
    stroke-linecap: round;
    opacity: 0.6;
  }

  .simbaa-reaction-clean .simbaa-bubble {
    fill: #dff3fb;
    stroke: #bfe3f2;
    stroke-width: 1;
  }

  .simbaa-reaction-clean path:not(.simbaa-bubble) {
    fill: #fff6d8;
  }

  .simbaa-reaction-adventure .simbaa-mud {
    fill: #8a6a49;
    opacity: 0.75;
  }

  .simbaa-visual[data-reaction="feed"] .simbaa-reaction-feed,
  .simbaa-visual[data-reaction="play"] .simbaa-reaction-play,
  .simbaa-visual[data-reaction="walk"] .simbaa-reaction-walk,
  .simbaa-visual[data-reaction="clean"] .simbaa-reaction-clean,
  .simbaa-visual[data-reaction="adventure"] .simbaa-reaction-adventure {
    animation: simbaa-reaction-mark 1.4s ease-out;
  }

  .simbaa-visual[data-reaction="feed"] .simbaa-cheek {
    animation: simbaa-cheek-puff 1.4s ease-out;
  }

  @keyframes simbaa-reaction-mark {
    0% {
      opacity: 0;
