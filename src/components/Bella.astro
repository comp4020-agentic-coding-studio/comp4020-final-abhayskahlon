---
// Bella's visual identity — a kitten, one of the five fixed, authored
// appearances the room's one shared creature can switch between
// (PROCESS.md, Decision 15). A self-contained sibling of Milo.astro: same
// Props shape, same mood-driven face branching via the already
// species-agnostic computeMood() (src/components/mood.ts), same
// always-rendered-but-hidden reaction-mark pattern, same scoped-style
// approach — deliberately NOT refactored into a shared base component with
// Milo.astro (see PROCESS.md, Decision 15, "no premature abstraction").
//
// Distinguishing silhouette: two triangular ears, long whiskers either
// side of the muzzle, a curled tail, pink inner ears.
import type { Activity, Stats } from "../lib/creature";
import { computeMood } from "./mood";

interface Props {
  activity: Activity;
  stats: Stats;
  hat?: string | null;
  neckwear?: string | null;
  glasses?: string | null;
}

const { activity, stats, hat = null, neckwear = null, glasses = null } = Astro.props;
const sleeping = activity === "sleeping";
const { family, severe } = computeMood(stats, activity);

function sparkle(cx: number, cy: number, r: number): string {
  const inner = r * 0.22;
  return `M${cx} ${cy - r} L${cx + inner} ${cy - inner} L${cx + r} ${cy} L${cx + inner} ${cy + inner} L${cx} ${cy + r} L${cx - inner} ${cy + inner} L${cx - r} ${cy} L${cx - inner} ${cy - inner} Z`;
}
---

<div class={`bella-visual bella-${family}`} data-severe={severe ? "true" : "false"}>
  <svg viewBox="0 0 160 160" class="bella-svg" role="img" aria-label={`Bella, ${sleeping ? "asleep" : family}`}>
    <!-- paws -->
    <ellipse class="bella-foot" cx="58" cy="144" rx="11" ry="6" />
    <ellipse class="bella-foot" cx="102" cy="144" rx="11" ry="6" />

    <!-- curled tail -->
    <path class="bella-tail" d="M128 110c16 2 24 18 12 26-9 6-18-2-15-11 2-6 1-11-5-15z" />

    <!-- triangular ears, symmetric -->
    <path class="bella-body-fill" d="M50 32 L38 4 L66 20 Z" />
    <path class="bella-body-fill" d="M110 32 L122 4 L94 20 Z" />
    <path class="bella-ear-inner" d="M51 26 L45 11 L60 20 Z" />
    <path class="bella-ear-inner" d="M109 26 L115 11 L100 20 Z" />

    <!-- body -->
    <path
      class="bella-body-fill"
      d="M80 18c31 0 52 24 54 57 2 27-10 55-37 63-11 3-23 3-34 0-27-8-39-36-37-63 2-33 23-57 54-57z"
    />

    <!-- belly marking -->
    <ellipse class="bella-belly" cx="80" cy="102" rx="26" ry="29" />

    <!-- cheeks -->
    <ellipse class="bella-cheek" cx="54" cy="90" rx="8" ry="5" />
    <ellipse class="bella-cheek" cx="106" cy="90" rx="8" ry="5" />

    <!-- whiskers, the defining kitten detail -->
    <g class="bella-whiskers" aria-hidden="true">
      <path d="M44 94c-10-2-18-1-24 3" />
      <path d="M44 100c-10 1-17 5-21 10" />
      <path d="M116 94c10-2 18-1 24 3" />
      <path d="M116 100c10 1 17 5 21 10" />
    </g>

    {
      hat === "top-hat" && (
        <g class="bella-wardrobe bella-hat-top" aria-hidden="true">
          <path d="M64 23c0-11 7-19 16-19s16 8 16 19z" />
          <ellipse cx="80" cy="23" rx="20" ry="4" />
          <rect x="65" y="14" width="30" height="5" />
        </g>
      )
    }
    {
      hat === "party-hat" && (
        <g class="bella-wardrobe bella-hat-party" aria-hidden="true">
          <path d="M80 3 L65 26 L95 26 Z" />
          <path d="M80 3 L75 14 L85 14 Z" class="bella-hat-party-stripe" />
          <circle cx="80" cy="3" r="3" class="bella-hat-party-pom" />
        </g>
      )
    }
    {
      hat === "beanie" && (
        <g class="bella-wardrobe bella-beanie" aria-hidden="true">
          <path d="M62 24c0-12 8-21 18-21s18 9 18 21z" />
          <rect x="60" y="20" width="40" height="7" rx="3" />
          <circle cx="80" cy="3" r="4" class="bella-beanie-pom" />
        </g>
      )
    }
    {
      hat === "bunny-ears" && (
        <g class="bella-wardrobe bella-bunny-ears" aria-hidden="true">
          <ellipse cx="64" cy="-6" rx="8" ry="28" transform="rotate(-8 64 -6)" />
          <ellipse cx="96" cy="-6" rx="8" ry="28" transform="rotate(8 96 -6)" />
          <ellipse class="bella-bunny-ears-inner" cx="64" cy="-6" rx="4" ry="20" transform="rotate(-8 64 -6)" />
          <ellipse class="bella-bunny-ears-inner" cx="96" cy="-6" rx="4" ry="20" transform="rotate(8 96 -6)" />
        </g>
      )
    }
    {
      hat === "wizard-hat" && (
        <g class="bella-wardrobe bella-wizard-hat" aria-hidden="true">
          <path d="M80 -2 L62 26 L98 26 Z" />
          <ellipse cx="80" cy="26" rx="22" ry="4" />
          <circle cx="76" cy="14" r="1.6" class="bella-wizard-star" />
          <circle cx="86" cy="8" r="1.3" class="bella-wizard-star" />
        </g>
      )
    }
    {
      hat === "golden-crown" && (
        <g class="bella-wardrobe bella-golden-crown" aria-hidden="true">
          <path d="M60 24 L66 8 L74 18 L80 4 L86 18 L94 8 L100 24 Z" />
          <rect x="60" y="22" width="40" height="6" rx="2" />
          <circle cx="80" cy="4" r="2.4" class="bella-crown-gem" />
        </g>
      )
    }
    {
      neckwear === "bow-tie" && (
        <g class="bella-wardrobe bella-bow-tie" aria-hidden="true">
          <path d="M80 108 L68 102 L68 114 Z" />
          <path d="M80 108 L92 102 L92 114 Z" />
          <circle cx="80" cy="108" r="3.2" class="bella-bow-knot" />
        </g>
      )
    }
    {
      neckwear === "scarf" && (
        <g class="bella-wardrobe bella-scarf" aria-hidden="true">
          <path d="M57 106c6 8 40 8 46 0l-2 9c-11 5-31 5-42 0z" />
          <path d="M90 112l8 16-10 1-5-15z" class="bella-scarf-tail" />
        </g>
      )
    }
    {
      neckwear === "knit-scarf" && (
        <g class="bella-wardrobe bella-knit-scarf" aria-hidden="true">
          <path d="M55 107c7 9 43 9 50 0l-2 10c-13 6-33 6-46 0z" />
          <path d="M88 116l6 18-9 1-5-17z" class="bella-knit-scarf-tail" />
        </g>
      )
    }

    {
      sleeping ? (
        <g class="bella-face bella-face-sleeping">
          <path class="bella-eye-line" d="M48 74c5-5 13-5 18 0" />
          <path class="bella-eye-line" d="M94 74c5-5 13-5 18 0" />
          <path class="bella-mouth" d="M72 96c5 4 11 4 16 0" />
          <g class="bella-zzz" aria-hidden="true">
            <text x="112" y="46" class="bella-zzz-char bella-zzz-1">z</text>
            <text x="124" y="34" class="bella-zzz-char bella-zzz-2">z</text>
            <text x="136" y="23" class="bella-zzz-char bella-zzz-3">z</text>
          </g>
        </g>
      ) : family === "happy" ? (
        <g class="bella-face">
          <ellipse class="bella-eye" cx="56" cy="76" rx="10" ry="11" />
          <ellipse class="bella-eye" cx="103" cy="76" rx="8.5" ry="9.5" />
          <circle class="bella-eye-highlight" cx="59.5" cy="71.5" r="2.6" />
          <circle class="bella-eye-highlight" cx="105.5" cy="72" r="2.2" />
          <path class="bella-mouth" d="M64 97c4 4 9 4 9 0c0 4 5 4 9 0" />
        </g>
      ) : family === "excited" ? (
        <g class="bella-face">
          <ellipse class="bella-eye" cx="56" cy="76" rx="10.5" ry="11.5" />
          <ellipse class="bella-eye" cx="103" cy="76" rx="9" ry="10" />
          <circle class="bella-eye-highlight" cx="59.5" cy="71" r="3" />
          <circle class="bella-eye-highlight" cx="106" cy="71.5" r="2.6" />
          <path class="bella-mouth" d="M60 96c8 11 32 11 40 0" />
          <g class="bella-sparkle-ambient" aria-hidden="true">
            <path d={sparkle(18, 44, 6.5)} />
            <path d={sparkle(136, 38, 6)} />
          </g>
        </g>
      ) : family === "sleepy" ? (
        <g class="bella-face">
          <path class="bella-eye-lid" d="M47 72c4-3 14-3 18 0l-1 6c-4 2-12 2-16 0z" />
          <path class="bella-eye-lid" d="M95 72c4-3 13-3 17 0l-1 6c-4 2-11 2-15 0z" />
          <path class="bella-eye-bag" d="M48 81c3 2 11 2 15 0" />
          <path class="bella-eye-bag" d="M96 81c3 2 10 2 14 0" />
          {severe ? (
            <>
              <ellipse class="bella-mouth-open" cx="80" cy="99" rx="6.5" ry="5.5" />
              <text x="100" y="66" class="bella-zzz-char bella-zzz-solo">z</text>
            </>
          ) : (
            <path class="bella-mouth" d="M68 98c4 2 20 2 24 0" />
          )}
        </g>
      ) : family === "hungry" ? (
        <g class="bella-face">
          <path class="bella-brow-up" d="M48 65c3-3 9-3 12-1" />
          <path class="bella-brow-up" d="M100 64c3-3 9-3 12 1" />
          <ellipse class="bella-eye" cx="56" cy="78" rx="10.5" ry="11" />
          <ellipse class="bella-eye" cx="103" cy="78" rx="9" ry="9.5" />
          <circle class="bella-eye-highlight" cx="59" cy="74" r="2.8" />
          <circle class="bella-eye-highlight" cx="105.5" cy="74.5" r="2.3" />
          <path class="bella-mouth" d="M68 99c3-3 9 3 12 0c3-3 9 3 12 0" />
          {severe && <path class="bella-rumble" d="M66 103c4-6 8 6 12 0s8-6 12 0" />}
        </g>
      ) : family === "sad" ? (
        <g class="bella-face">
          <path class="bella-brow-down" d="M48 67c3 3 9 4 12 2" />
          <path class="bella-brow-down" d="M100 69c3-2 9-3 12-1" />
          <ellipse class="bella-eye" cx="56" cy="78" rx="9" ry="9.5" />
          <ellipse class="bella-eye" cx="103" cy="78" rx="8" ry="8.5" />
          <path class="bella-mouth" d="M64 101c7-8 25-8 32 0" />
          {severe && (
            <g class="bella-cloud" aria-hidden="true">
              <path d="M58 18c-5 0-8 3-9 6-4 1-7 4-7 8 0 4 4 7 8 7h23c4 0 7-3 7-7 0-3-2-6-5-7 0-5-4-9-9-9-3 0-6 1-8 2z" />
              <path class="bella-raindrop bella-raindrop-1" d="M58 42v5" />
              <path class="bella-raindrop bella-raindrop-2" d="M70 44v5" />
            </g>
          )}
        </g>
      ) : (
        <g class="bella-face">
          <path class="bella-eye-line bella-eye-squint" d="M47 75c4-4 13-4 18 0" />
          <ellipse class="bella-eye" cx="103" cy="77" rx="7.5" ry="8" />
          <circle class="bella-eye-highlight" cx="105" cy="74" r="1.8" />
          <path class="bella-mouth" d="M70 98c4 3 12 3 16 0" />
          <g class="bella-dirt" aria-hidden="true">
            <ellipse cx="64" cy="116" rx="2.6" ry="1.8" transform="rotate(20 64 116)" />
            <ellipse cx="94" cy="120" rx="2.2" ry="1.6" transform="rotate(-15 94 120)" />
            <ellipse cx="74" cy="127" rx="2" ry="1.5" />
            <ellipse cx="100" cy="109" rx="1.8" ry="1.4" />
          </g>
          {severe && (
            <>
              <path class="bella-stink bella-stink-1" d="M26 68c-2-4 2-6 0-10s2-6 0-10" />
              <path class="bella-stink bella-stink-2" d="M136 64c2-4-2-6 0-10s-2-6 0-10" />
            </>
          )}
        </g>
      )
    }

    {
      glasses === "round-glasses" && (
        <g class="bella-wardrobe bella-round-glasses" aria-hidden="true">
          <circle cx="56" cy="78" r="9" />
          <circle cx="104" cy="78" r="9" />
          <path d="M65 78h30" />
        </g>
      )
    }
    {
      glasses === "heart-glasses" && (
        <g class="bella-wardrobe bella-heart-glasses" aria-hidden="true">
          <path d="M56 73c-3-3-8-2-8 2 0 3 4 6 8 9 4-3 8-6 8-9 0-4-5-5-8-2z" />
          <path d="M104 73c-3-3-8-2-8 2 0 3 4 6 8 9 4-3 8-6 8-9 0-4-5-5-8-2z" />
          <path d="M64 78h32" />
        </g>
      )
    }

    <g class="bella-reaction bella-reaction-feed" aria-hidden="true">
      <circle cx="66" cy="108" r="3.2" />
      <circle cx="94" cy="110" r="2.6" />
      <circle cx="80" cy="116" r="2.3" />
    </g>
    <g class="bella-reaction bella-reaction-play" aria-hidden="true">
      <path d={sparkle(36, 58, 7)} />
      <path d={sparkle(124, 54, 6)} />
      <path d={sparkle(80, 28, 5)} />
    </g>
    <g class="bella-reaction bella-reaction-walk" aria-hidden="true">
      <path d="M24 136c-4 1-6 4-6 7" />
      <path d="M19 125c-4 1-7 3-8 6" />
      <path d="M27 147c-4 0-7 2-8 5" />
    </g>
    <g class="bella-reaction bella-reaction-clean" aria-hidden="true">
      <circle class="bella-bubble" cx="38" cy="68" r="4" />
      <circle class="bella-bubble" cx="125" cy="58" r="3" />
      <circle class="bella-bubble" cx="119" cy="94" r="2.4" />
      <path d={sparkle(80, 54, 5)} />
    </g>
    <g class="bella-reaction bella-reaction-adventure" aria-hidden="true">
      <ellipse class="bella-mud" cx="58" cy="118" rx="6" ry="3.5" transform="rotate(-10 58 118)" />
      <ellipse class="bella-mud" cx="100" cy="124" rx="5" ry="3" transform="rotate(8 100 124)" />
      <ellipse class="bella-mud" cx="78" cy="132" rx="4" ry="2.4" />
    </g>
  </svg>
</div>

<style>
  .bella-visual {
    position: relative;
    display: inline-block;
    width: clamp(7.5rem, 24vw, 10.5rem);
    margin: 0 auto;
  }

  .bella-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .bella-body-fill {
    fill: var(--bella-body, #e8a6c1);
    stroke: var(--bella-outline, #6b3b52);
    stroke-width: 3;
    stroke-linejoin: round;
  }

  .bella-ear-inner {
    fill: #ffd3e2;
    stroke: none;
  }

  .bella-foot {
    fill: var(--bella-body, #e8a6c1);
    stroke: var(--bella-outline, #6b3b52);
    stroke-width: 3;
  }

  .bella-tail {
    fill: var(--bella-body, #e8a6c1);
    stroke: var(--bella-outline, #6b3b52);
    stroke-width: 3;
    stroke-linejoin: round;
  }

  .bella-belly {
    fill: var(--bella-belly, #fbdce9);
    stroke: none;
  }

  .bella-cheek {
    fill: #ff8fa3;
    opacity: 0.45;
    transform-origin: center;
  }

  .bella-whiskers {
    fill: none;
    stroke: var(--bella-outline, #6b3b52);
    stroke-width: 1.4;
    stroke-linecap: round;
    opacity: 0.6;
  }

  .bella-eye,
  .bella-eye-lid {
    fill: var(--bella-outline, #4a2436);
  }

  .bella-eye-line,
  .bella-eye-squint {
    fill: none;
    stroke: var(--bella-outline, #4a2436);
    stroke-width: 3;
    stroke-linecap: round;
  }

  .bella-eye-bag,
  .bella-brow-up,
  .bella-brow-down,
  .bella-rumble,
  .bella-stink {
    fill: none;
    stroke: var(--bella-outline, #4a2436);
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0.55;
  }

  .bella-eye-highlight {
    fill: #fff;
  }

  .bella-mouth {
    fill: none;
    stroke: var(--bella-outline, #4a2436);
    stroke-width: 3;
    stroke-linecap: round;
  }

  .bella-mouth-open {
    fill: var(--bella-outline, #4a2436);
    opacity: 0.85;
  }

  .bella-wardrobe {
    stroke: var(--bella-outline, #4a2436);
    stroke-width: 1.6;
    stroke-linejoin: round;
  }

  .bella-hat-top {
    fill: #2b2420;
  }
  .bella-hat-party {
    fill: #ff8a5b;
  }
  .bella-hat-party-stripe {
    fill: #fff6d8;
  }
  .bella-hat-party-pom {
    fill: #ffcf6b;
  }
  .bella-beanie {
    fill: #5b8aa8;
  }
  .bella-beanie-pom {
    fill: #fff;
  }
  .bella-bunny-ears {
    fill: #f4cfe0;
  }
  .bella-bunny-ears-inner {
    fill: #ff9fc0;
    stroke: none;
  }
  .bella-wizard-hat {
    fill: #5a3fae;
  }
  .bella-wizard-star {
    fill: #ffd76b;
    stroke: none;
  }
  .bella-golden-crown {
    fill: #f4c430;
  }
  .bella-crown-gem {
    fill: #c7453a;
    stroke: none;
  }
  .bella-round-glasses,
  .bella-heart-glasses {
    fill: none;
    stroke: #2b2420;
    stroke-width: 2.2;
  }
  .bella-bow-tie {
    fill: #c7453a;
  }
  .bella-bow-knot {
    fill: #9c342b;
    stroke: none;
  }
  .bella-scarf,
  .bella-scarf-tail {
    fill: #3f8f5f;
  }
  .bella-knit-scarf,
  .bella-knit-scarf-tail {
    fill: #6a4fae;
  }

  .bella-happy,
  .bella-excited {
    --bella-body: #e8a6c1;
    --bella-belly: #fbdce9;
  }

  .bella-sleepy,
  .bella-sleeping {
    --bella-body: #c7b8cc;
    --bella-belly: #e9dfec;
  }

  .bella-hungry {
    --bella-body: #e6b58f;
    --bella-belly: #f8ddc4;
  }

  .bella-sad {
    --bella-body: #b3b7df;
    --bella-belly: #dcdef3;
  }

  .bella-messy {
    --bella-body: #c29a79;
    --bella-belly: #dcc19c;
  }

  .bella-sparkle-ambient path {
    fill: #ffcf6b;
  }

  .bella-cloud path:first-child {
    fill: #c6d3e2;
  }

  .bella-raindrop {
    stroke: #8fa9c9;
    stroke-width: 2.4;
    stroke-linecap: round;
    animation: bella-raindrop-fall 1.6s ease-in infinite;
  }

  .bella-raindrop-2 {
    animation-delay: 0.5s;
  }

  .bella-dirt ellipse {
    fill: #8a6a49;
    opacity: 0.6;
  }

  .bella-zzz-char {
    font: 700 1rem/1 ui-rounded, system-ui, sans-serif;
    fill: var(--color-muted);
  }

  .bella-zzz-solo {
    font-size: 0.75rem;
    opacity: 0.7;
    animation: bella-zzz-float 2.6s ease-in infinite;
  }

  .bella-reaction {
    opacity: 0;
  }

  .bella-reaction-feed circle {
    fill: #c98a4b;
  }

  .bella-reaction-play path {
    fill: #ffcf6b;
  }

  .bella-reaction-walk path {
    fill: none;
    stroke: var(--color-accent-ink, #b84b22);
    stroke-width: 2.2;
    stroke-linecap: round;
    opacity: 0.6;
  }

  .bella-reaction-clean .bella-bubble {
    fill: #dff3fb;
    stroke: #bfe3f2;
    stroke-width: 1;
  }

  .bella-reaction-clean path:not(.bella-bubble) {
    fill: #fff6d8;
  }

  .bella-reaction-adventure .bella-mud {
    fill: #8a6a49;
    opacity: 0.75;
  }

  .bella-visual[data-reaction="feed"] .bella-reaction-feed,
  .bella-visual[data-reaction="play"] .bella-reaction-play,
  .bella-visual[data-reaction="walk"] .bella-reaction-walk,
  .bella-visual[data-reaction="clean"] .bella-reaction-clean,
  .bella-visual[data-reaction="adventure"] .bella-reaction-adventure {
    animation: bella-reaction-mark 1.4s ease-out;
  }

  .bella-visual[data-reaction="feed"] .bella-cheek {
    animation: bella-cheek-puff 1.4s ease-out;
  }

  @keyframes bella-reaction-mark {
    0% {
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    75% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes bella-cheek-puff {
    0%,
    100% {
      transform: scale(1);
    }
    30% {
      transform: scale(1.22);
    }
  }

  @keyframes bella-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    25% {
      transform: translateY(-6px);
    }
    50% {
      transform: translateY(0);
    }
    70% {
      transform: translateY(-3px);
    }
  }

  @keyframes bella-settle {
    0% {
      transform: scale(1);
    }
    40% {
      transform: scale(0.94);
    }
    70% {
      transform: scale(1.03);
    }
    100% {
      transform: scale(1);
    }
  }

  .bella-visual:not(.bella-sleeping) .bella-svg {
    animation: bella-breathe 3.6s ease-in-out infinite;
    transform-origin: 50% 85%;
  }

