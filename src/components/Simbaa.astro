---
// Simbaa's visual identity — a baby lamb, one of the five fixed, authored
// appearances the room's one shared creature can switch between
// (PROCESS.md, Decision 15). A self-contained sibling of Milo.astro: same
// Props shape, same mood-driven face branching via the already
// species-agnostic computeMood() (src/components/mood.ts), same
// always-rendered-but-hidden reaction-mark pattern, same scoped-style
// approach — deliberately NOT refactored into a shared base component with
// Milo.astro (see PROCESS.md, Decision 15, "no premature abstraction").
//
// Redesigned (see PROCESS.md, Decision 15's follow-up): the original wool
// silhouette was a plain oval body with small circles dotted around its
// outline, which read as "decorated," not "fleece" — a real, reported
// problem, not a hypothetical one. The fleece here is instead two genuine
// scalloped-cloud shapes (one for the head, one for the body), each built
// from evenly-spaced points on an ellipse connected by OUTWARD-BULGING ARCS
// (the standard cloud/fleece-outline technique — large rounded lobes with
// no straight edges), not a smooth oval with circles layered on top of it.
// A separate, lighter face plate sits on top of the head fleece so the face
// itself reads as skin, not wool — this is also new: the old version had no
// visual separation between face and fleece at all.
//
// Second follow-up (reported directly, against a reference image): the
// face plate above was too small and the ears too large relative to it,
// so the head read as "mostly dark eyes and big ears" rather than "a
// large, soft, friendly face." The face ellipse here is enlarged to
// roughly 29x27 (was 27x24) against the SAME 80x38 head-fleece radius, and
// every eye in the mood table below is shrunk and lightened to a warm
// brown rather than the near-black outline color the rest of the face
// uses for eye fill — large pupils in a near-black tone were themselves
// part of why the face read as "small and dark." The ears are reduced by
// about 30% (rx 16->11, ry 24->17, was already rotated outward) so they
// stay visibly lamb-like (still floppy, still diagonal, still pink-lined)
// without visually outweighing the now-larger face.
import type { Activity, Stats } from "../lib/creature";
import { computeMood } from "./mood";

interface Props {
  activity: Activity;
  stats: Stats;
  hat?: string | null;
  neckwear?: string | null;
  glasses?: string | null;
}

const { activity, stats, hat = null, neckwear = null, glasses = null } = Astro.props;
const sleeping = activity === "sleeping";
const { family, severe } = computeMood(stats, activity);

function sparkle(cx: number, cy: number, r: number): string {
  const inner = r * 0.22;
  return `M${cx} ${cy - r} L${cx + inner} ${cy - inner} L${cx + r} ${cy} L${cx + inner} ${cy + inner} L${cx} ${cy + r} L${cx - inner} ${cy + inner} L${cx - r} ${cy} L${cx - inner} ${cy - inner} Z`;
}
---

<div class={`simbaa-visual simbaa-${family}`} data-severe={severe ? "true" : "false"}>
  <svg viewBox="0 0 160 160" class="simbaa-svg" role="img" aria-label={`Simbaa, ${sleeping ? "asleep" : family}`}>
    <!-- short legs + dark hooves, drawn first so the body wool overlaps
         their tops -->
    <rect class="simbaa-leg" x="54" y="142" width="10" height="16" rx="4" />
    <rect class="simbaa-leg" x="96" y="142" width="10" height="16" rx="4" />
    <rect class="simbaa-hoof" x="52.5" y="152" width="13" height="7" rx="2.5" />
    <rect class="simbaa-hoof" x="94.5" y="152" width="13" height="7" rx="2.5" />

    <!-- a small tail, peeking from the body's own wool at the back -->
    <circle class="simbaa-tail" cx="123" cy="128" r="8" />

    <!-- floppy, droopy ears extending sideways — drawn before the head
         fleece so the fleece overlaps their inner base, with the tips
         still clearly visible either side. Reduced ~30% from the prior
         size (rx 16->11, ry 24->17) so they read as secondary to the
         now-larger face rather than visually overpowering the head; still
         floppy, still diagonal, still pink-lined, so they stay
         recognisably lamb-like rather than shrinking into generic nubs. -->
    <ellipse class="simbaa-ear" cx="34" cy="66" rx="11" ry="17" transform="rotate(-55 34 66)" />
    <ellipse class="simbaa-ear" cx="126" cy="66" rx="11" ry="17" transform="rotate(55 126 66)" />
    <ellipse class="simbaa-ear-inner" cx="34" cy="66" rx="6" ry="11" transform="rotate(-55 34 66)" />
    <ellipse class="simbaa-ear-inner" cx="126" cy="66" rx="6" ry="11" transform="rotate(55 126 66)" />

    <!-- body fleece: a genuine scalloped cloud (10 outward-bulging arcs
         around a base ellipse), not a smooth oval with circles on top. -->
    <path
      class="simbaa-wool"
      d="M123.51 123.08 A13.43 13.43 0 0 1 111.33 141.87 A15.60 15.60 0 0 1 87.19 151.54 A16.24 16.24 0 0 1 60.30 148.40 A14.61 14.61 0 0 1 40.94 133.65 A12.72 12.72 0 0 1 36.49 112.92 A13.43 13.43 0 0 1 48.67 94.13 A15.60 15.60 0 0 1 72.81 84.46 A16.24 16.24 0 0 1 99.70 87.60 A14.61 14.61 0 0 1 119.06 102.35 A12.72 12.72 0 0 1 123.51 123.08 Z"
    />

    <!-- head fleece: the same scalloped-cloud technique, a separate shape
         slightly overlapping the body fleece below it. -->
    <path
      class="simbaa-wool"
      d="M122.00 58.00 A15.80 15.80 0 0 1 112.17 82.43 A16.84 16.84 0 0 1 87.29 95.42 A17.19 17.19 0 0 1 59.00 90.91 A16.29 16.29 0 0 1 40.53 71.00 A15.60 15.60 0 0 1 40.53 45.00 A16.29 16.29 0 0 1 59.00 25.09 A17.19 17.19 0 0 1 87.29 20.58 A16.84 16.84 0 0 1 112.17 33.57 A15.80 15.80 0 0 1 122.00 58.00 Z"
    />

    <!-- face plate: a distinct, lighter surface on top of the head fleece
         so the face reads as skin, not wool. Enlarged from the first
         redesign's 27x24 to 29x27 — against the same head-fleece radius,
         this is the single biggest lever for "face fills most of the
         head" rather than "a small patch surrounded by wool." -->
    <ellipse class="simbaa-face-plate" cx="80" cy="65" rx="29" ry="27" />

    <!-- cheeks -->
    <ellipse class="simbaa-cheek" cx="59" cy="74" rx="7" ry="4.5" />
    <ellipse class="simbaa-cheek" cx="101" cy="74" rx="7" ry="4.5" />

    {
      hat === "top-hat" && (
        <g class="simbaa-wardrobe simbaa-hat-top" aria-hidden="true">
          <path d="M64 21c0-11 7-19 16-19s16 8 16 19z" />
          <ellipse cx="80" cy="21" rx="20" ry="4" />
          <rect x="65" y="12" width="30" height="5" />
        </g>
      )
    }
    {
      hat === "party-hat" && (
        <g class="simbaa-wardrobe simbaa-hat-party" aria-hidden="true">
          <path d="M80 1 L65 24 L95 24 Z" />
          <path d="M80 1 L75 12 L85 12 Z" class="simbaa-hat-party-stripe" />
          <circle cx="80" cy="1" r="3" class="simbaa-hat-party-pom" />
        </g>
      )
    }
    {
      hat === "beanie" && (
        <g class="simbaa-wardrobe simbaa-beanie" aria-hidden="true">
          <path d="M62 22c0-12 8-21 18-21s18 9 18 21z" />
          <rect x="60" y="18" width="40" height="7" rx="3" />
          <circle cx="80" cy="1" r="4" class="simbaa-beanie-pom" />
        </g>
      )
    }
    {
      hat === "bunny-ears" && (
        <g class="simbaa-wardrobe simbaa-bunny-ears" aria-hidden="true">
          <ellipse cx="64" cy="-8" rx="8" ry="28" transform="rotate(-8 64 -8)" />
          <ellipse cx="96" cy="-8" rx="8" ry="28" transform="rotate(8 96 -8)" />
          <ellipse class="simbaa-bunny-ears-inner" cx="64" cy="-8" rx="4" ry="20" transform="rotate(-8 64 -8)" />
          <ellipse class="simbaa-bunny-ears-inner" cx="96" cy="-8" rx="4" ry="20" transform="rotate(8 96 -8)" />
        </g>
      )
    }
    {
      hat === "wizard-hat" && (
        <g class="simbaa-wardrobe simbaa-wizard-hat" aria-hidden="true">
          <path d="M80 -4 L62 24 L98 24 Z" />
          <ellipse cx="80" cy="24" rx="22" ry="4" />
          <circle cx="76" cy="12" r="1.6" class="simbaa-wizard-star" />
          <circle cx="86" cy="6" r="1.3" class="simbaa-wizard-star" />
        </g>
      )
    }
    {
      hat === "golden-crown" && (
        <g class="simbaa-wardrobe simbaa-golden-crown" aria-hidden="true">
          <path d="M60 22 L66 6 L74 16 L80 2 L86 16 L94 6 L100 22 Z" />
          <rect x="60" y="20" width="40" height="6" rx="2" />
          <circle cx="80" cy="2" r="2.4" class="simbaa-crown-gem" />
        </g>
      )
    }
    {
      neckwear === "bow-tie" && (
        <g class="simbaa-wardrobe simbaa-bow-tie" aria-hidden="true">
          <path d="M80 95 L68 89 L68 101 Z" />
          <path d="M80 95 L92 89 L92 101 Z" />
          <circle cx="80" cy="95" r="3.2" class="simbaa-bow-knot" />
        </g>
      )
    }
    {
      neckwear === "scarf" && (
        <g class="simbaa-wardrobe simbaa-scarf" aria-hidden="true">
          <path d="M55 92c6 8 40 8 46 0l-2 9c-11 5-31 5-42 0z" />
          <path d="M88 98l8 16-10 1-5-15z" class="simbaa-scarf-tail" />
        </g>
      )
    }
    {
      neckwear === "knit-scarf" && (
        <g class="simbaa-wardrobe simbaa-knit-scarf" aria-hidden="true">
          <path d="M53 93c7 9 43 9 50 0l-2 10c-13 6-33 6-46 0z" />
          <path d="M86 102l6 18-9 1-5-17z" class="simbaa-knit-scarf-tail" />
        </g>
      )
    }

    {
      sleeping ? (
        <g class="simbaa-face simbaa-face-sleeping">
          <path class="simbaa-eye-line" d="M60 62c4-4 11-4 15 0" />
          <path class="simbaa-eye-line" d="M85 62c4-4 11-4 15 0" />
          <path class="simbaa-mouth" d="M75 76c3 3 7 3 10 0" />
          <g class="simbaa-zzz" aria-hidden="true">
            <text x="112" y="46" class="simbaa-zzz-char simbaa-zzz-1">z</text>
            <text x="124" y="34" class="simbaa-zzz-char simbaa-zzz-2">z</text>
            <text x="136" y="23" class="simbaa-zzz-char simbaa-zzz-3">z</text>
          </g>
        </g>
      ) : family === "happy" ? (
        <g class="simbaa-face">
          <ellipse class="simbaa-eye" cx="68" cy="64" rx="5.6" ry="6.5" />
          <ellipse class="simbaa-eye" cx="92" cy="64" rx="4.9" ry="5.8" />
          <circle class="simbaa-eye-highlight" cx="70.2" cy="60.8" r="1.7" />
          <circle class="simbaa-eye-highlight" cx="94" cy="61.2" r="1.4" />
          <path class="simbaa-nose" d="M75 71c0-2.2 2.2-3.5 5-3.5s5 1.3 5 3.5-2.2 3.2-5 3.2-5-1-5-3.2z" />
          <path class="simbaa-mouth" d="M72 78c3 3 5 3 8 3s5 0 8-3" />
        </g>
      ) : family === "excited" ? (
        <g class="simbaa-face">
          <ellipse class="simbaa-eye" cx="68" cy="63.5" rx="5.9" ry="6.8" />
          <ellipse class="simbaa-eye" cx="92" cy="63.5" rx="5.2" ry="6.1" />
          <circle class="simbaa-eye-highlight" cx="70.4" cy="60" r="1.9" />
          <circle class="simbaa-eye-highlight" cx="94.2" cy="60.4" r="1.6" />
          <path class="simbaa-nose" d="M75 71c0-2.2 2.2-3.5 5-3.5s5 1.3 5 3.5-2.2 3.2-5 3.2-5-1-5-3.2z" />
          <path class="simbaa-mouth" d="M70 77c4 5 12 5 20 0" />
          <g class="simbaa-sparkle-ambient" aria-hidden="true">
            <path d={sparkle(18, 48, 6.5)} />
            <path d={sparkle(136, 42, 6)} />
          </g>
        </g>
      ) : family === "sleepy" ? (
        <g class="simbaa-face">
          <path class="simbaa-eye-lid" d="M61 61c3.5-3 11-3 14.5 0l-1 5c-3.5 2-9.5 2-12.5 0z" />
          <path class="simbaa-eye-lid" d="M85 61c3.5-3 10.5-3 14 0l-1 5c-3.5 2-9 2-12.5 0z" />
          <path class="simbaa-nose" d="M75 71c0-2.2 2.2-3.5 5-3.5s5 1.3 5 3.5-2.2 3.2-5 3.2-5-1-5-3.2z" />
          {severe ? (
            <>
              <ellipse class="simbaa-mouth-open" cx="80" cy="80" rx="5.5" ry="4.5" />
              <text x="100" y="52" class="simbaa-zzz-char simbaa-zzz-solo">z</text>
            </>
          ) : (
            <path class="simbaa-mouth" d="M73 79c3 2 11 2 14 0" />
          )}
        </g>
      ) : family === "hungry" ? (
        <g class="simbaa-face">
          <path class="simbaa-brow-up" d="M61 55c3-3 8-3 11-1" />
          <path class="simbaa-brow-up" d="M88 54c3-3 8-3 11 1" />
          <ellipse class="simbaa-eye" cx="68" cy="65" rx="5.9" ry="6.3" />
          <ellipse class="simbaa-eye" cx="92" cy="65" rx="5.2" ry="5.6" />
          <circle class="simbaa-eye-highlight" cx="70.2" cy="62" r="1.7" />
          <circle class="simbaa-eye-highlight" cx="94" cy="62.4" r="1.4" />
          <path class="simbaa-nose" d="M75 72c0-2.2 2.2-3.5 5-3.5s5 1.3 5 3.5-2.2 3.2-5 3.2-5-1-5-3.2z" />
          <path class="simbaa-mouth" d="M73 80c2-2 5 2 7 0c2-2 5 2 7 0" />
          {severe && <path class="simbaa-rumble" d="M69 85c3-5 6 5 9 0s6-5 9 0" />}
        </g>
      ) : family === "sad" ? (
        <g class="simbaa-face">
          <path class="simbaa-brow-down" d="M61 56c3 3 8 4 11 2" />
          <path class="simbaa-brow-down" d="M88 58c3-2 8-3 11-1" />
          <ellipse class="simbaa-eye" cx="68" cy="65" rx="5.0" ry="5.6" />
          <ellipse class="simbaa-eye" cx="92" cy="65" rx="4.5" ry="5.0" />
          <path class="simbaa-nose" d="M75 72c0-2.2 2.2-3.5 5-3.5s5 1.3 5 3.5-2.2 3.2-5 3.2-5-1-5-3.2z" />
          <path class="simbaa-mouth" d="M71 81c5-6 13-6 18 0" />
          {severe && (
            <g class="simbaa-cloud" aria-hidden="true">
              <path d="M58 14c-5 0-8 3-9 6-4 1-7 4-7 8 0 4 4 7 8 7h23c4 0 7-3 7-7 0-3-2-6-5-7 0-5-4-9-9-9-3 0-6 1-8 2z" />
              <path class="simbaa-raindrop simbaa-raindrop-1" d="M58 38v5" />
              <path class="simbaa-raindrop simbaa-raindrop-2" d="M70 40v5" />
            </g>
          )}
        </g>
      ) : (
        <g class="simbaa-face">
          <path class="simbaa-eye-line simbaa-eye-squint" d="M61 65c3.5-3.5 10.5-3.5 14 0" />
          <ellipse class="simbaa-eye" cx="92" cy="66" rx="4.5" ry="5.0" />
          <circle class="simbaa-eye-highlight" cx="94" cy="63.5" r="1.3" />
          <path class="simbaa-nose" d="M75 72c0-2.2 2.2-3.5 5-3.5s5 1.3 5 3.5-2.2 3.2-5 3.2-5-1-5-3.2z" />
          <path class="simbaa-mouth" d="M74 78c3 2.5 9 2.5 12 0" />
          <g class="simbaa-dirt" aria-hidden="true">
            <ellipse cx="60" cy="100" rx="2.6" ry="1.8" transform="rotate(20 60 100)" />
            <ellipse cx="100" cy="104" rx="2.2" ry="1.6" transform="rotate(-15 100 104)" />
            <ellipse cx="72" cy="110" rx="2" ry="1.5" />
          </g>
          {severe && (
            <>
              <path class="simbaa-stink simbaa-stink-1" d="M26 70c-2-4 2-6 0-10s2-6 0-10" />
              <path class="simbaa-stink simbaa-stink-2" d="M136 66c2-4-2-6 0-10s-2-6 0-10" />
            </>
          )}
        </g>
      )
    }

    {
      glasses === "round-glasses" && (
        <g class="simbaa-wardrobe simbaa-round-glasses" aria-hidden="true">
          <circle cx="68" cy="64" r="9" />
          <circle cx="92" cy="64" r="9" />
          <path d="M77 64h6" />
        </g>
      )
    }
    {
      glasses === "heart-glasses" && (
        <g class="simbaa-wardrobe simbaa-heart-glasses" aria-hidden="true">
          <path d="M68 59c-3-3-8-2-8 2 0 3 4 6 8 9 4-3 8-6 8-9 0-4-5-5-8-2z" />
          <path d="M92 59c-3-3-8-2-8 2 0 3 4 6 8 9 4-3 8-6 8-9 0-4-5-5-8-2z" />
          <path d="M76 64h8" />
        </g>
      )
    }

    <g class="simbaa-reaction simbaa-reaction-feed" aria-hidden="true">
      <circle cx="66" cy="96" r="3.2" />
      <circle cx="94" cy="98" r="2.6" />
      <circle cx="80" cy="104" r="2.3" />
    </g>
    <g class="simbaa-reaction simbaa-reaction-play" aria-hidden="true">
      <path d={sparkle(36, 60, 7)} />
      <path d={sparkle(124, 56, 6)} />
      <path d={sparkle(80, 14, 5)} />
    </g>
    <g class="simbaa-reaction simbaa-reaction-walk" aria-hidden="true">
      <path d="M24 136c-4 1-6 4-6 7" />
      <path d="M19 125c-4 1-7 3-8 6" />
      <path d="M27 147c-4 0-7 2-8 5" />
    </g>
    <g class="simbaa-reaction simbaa-reaction-clean" aria-hidden="true">
      <circle class="simbaa-bubble" cx="38" cy="70" r="4" />
      <circle class="simbaa-bubble" cx="125" cy="60" r="3" />
      <circle class="simbaa-bubble" cx="119" cy="96" r="2.4" />
      <path d={sparkle(80, 40, 5)} />
    </g>
    <g class="simbaa-reaction simbaa-reaction-adventure" aria-hidden="true">
      <ellipse class="simbaa-mud" cx="58" cy="138" rx="6" ry="3.5" transform="rotate(-10 58 138)" />
      <ellipse class="simbaa-mud" cx="100" cy="140" rx="5" ry="3" transform="rotate(8 100 140)" />
      <ellipse class="simbaa-mud" cx="78" cy="148" rx="4" ry="2.4" />
    </g>
  </svg>
</div>

<style>
  .simbaa-visual {
    position: relative;
    display: inline-block;
    width: clamp(7.5rem, 24vw, 10.5rem);
    margin: 0 auto;
  }

  .simbaa-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .simbaa-wool {
    fill: var(--simbaa-body, #fbf6ea);
    stroke: var(--simbaa-outline, #8a7a5c);
    stroke-width: 3;
    stroke-linejoin: round;
  }

  .simbaa-face-plate {
    fill: var(--simbaa-face, #fffaf0);
    stroke: var(--simbaa-outline, #8a7a5c);
    stroke-width: 2;
  }

  .simbaa-ear {
    fill: var(--simbaa-ear, #e8c9a0);
    stroke: var(--simbaa-outline, #8a7a5c);
    stroke-width: 2.6;
  }

  .simbaa-ear-inner {
    fill: var(--simbaa-ear-inner, #ffc2cc);
    stroke: none;
  }

  .simbaa-leg {
    fill: var(--simbaa-ear, #e8c9a0);
    stroke: var(--simbaa-outline, #8a7a5c);
    stroke-width: 2.2;
  }

  .simbaa-hoof {
    fill: var(--simbaa-hoof, #5a4328);
    stroke: var(--simbaa-hoof, #5a4328);
    stroke-width: 1;
  }

  .simbaa-tail {
    fill: var(--simbaa-body, #fbf6ea);
    stroke: var(--simbaa-outline, #8a7a5c);
    stroke-width: 2.6;
  }

  .simbaa-cheek {
    fill: #ff8fa3;
    opacity: 0.4;
    transform-origin: center;
  }

  .simbaa-nose {
    fill: var(--simbaa-nose, #ff9aa8);
  }

  /* Warm brown, deliberately NOT the same near-black tone as
     --simbaa-outline (used for lids/lines/brows) — large eyes filled with
     the outline color read as a dark mask dominating the face; a lighter,
     warmer brown keeps them expressive without visually overpowering the
     now-larger, lighter face plate around them. */
  .simbaa-eye {
    fill: var(--simbaa-eye, #6b4226);
  }

  .simbaa-eye-lid {
    fill: var(--simbaa-outline, #5a4b32);
  }

  .simbaa-eye-line,
  .simbaa-eye-squint {
    fill: none;
    stroke: var(--simbaa-outline, #5a4b32);
    stroke-width: 3;
    stroke-linecap: round;
  }

  .simbaa-eye-bag,
  .simbaa-brow-up,
  .simbaa-brow-down,
  .simbaa-rumble,
  .simbaa-stink {
    fill: none;
    stroke: var(--simbaa-outline, #5a4b32);
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0.55;
  }

  .simbaa-eye-highlight {
    fill: #fff;
  }

  .simbaa-mouth {
    fill: none;
    stroke: var(--simbaa-outline, #5a4b32);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .simbaa-mouth-open {
    fill: var(--simbaa-outline, #5a4b32);
    opacity: 0.85;
  }

  .simbaa-wardrobe {
    stroke: var(--simbaa-outline, #5a4b32);
    stroke-width: 1.6;
    stroke-linejoin: round;
  }

  .simbaa-hat-top {
    fill: #2b2420;
  }
  .simbaa-hat-party {
    fill: #ff8a5b;
  }
  .simbaa-hat-party-stripe {
    fill: #fff6d8;
  }
  .simbaa-hat-party-pom {
    fill: #ffcf6b;
  }
  .simbaa-beanie {
    fill: #5b8aa8;
  }
  .simbaa-beanie-pom {
